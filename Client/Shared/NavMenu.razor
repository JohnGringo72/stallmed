<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">OrderManager</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="orders">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Orders
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Doctors">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Doctors
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mytasks">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Εργασίες
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mytasks/new">
                <span class="oi oi-plus" aria-hidden="true"></span> Νέα Εργασία
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mytasks/history">
                <span class="oi oi-folder" aria-hidden="true"></span> Ιστορικό
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stock-search">
                <i class="bi bi-capsule me-2"></i> Αναζήτηση Treatments
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}