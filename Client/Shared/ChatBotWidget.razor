@using StallmedManager.Shared.Models
@inject DataService dataService
@inject UserManager userManager
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (userManager.IsLoggedIn)
{
    <div class="ai-chat-root">
        @if (isOpen)
        {
            <div class="ai-panel">
                <div class="ai-header">
                    <div class="ai-header-info">
                        <span class="ai-title">SBT Suite Bot</span>
                        <span class="ai-subtitle"><span class="ai-online-dot"></span> Online · Stock &amp; Orders Assistant</span>
                    </div>
                    <button class="ai-close" title="Κλείσιμο" @onclick="Toggle">✕</button>
                </div>

                <div class="ai-messages" @ref="messagesRef">
                    @foreach (var msg in messages)
                    {
                        <div class="ai-bubble-row @(msg.Role == "user" ? "ai-row-user" : "ai-row-assistant")">
                            <div class="ai-bubble @(msg.Role == "user" ? "ai-bubble-user" : "ai-bubble-assistant")">@msg.Content</div>
                        </div>
                    }
                    @if (isBusy)
                    {
                        <div class="ai-bubble-row ai-row-assistant">
                            <div class="ai-bubble ai-bubble-assistant ai-typing">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    }
                    @if (messages.Count <= 1 && !isBusy)
                    {
                        <div class="ai-chips">
                            @foreach (var chip in suggestionChips)
                            {
                                <button class="ai-chip" @onclick="() => SendChip(chip)">@chip</button>
                            }
                        </div>
                    }
                </div>

                <div class="ai-input-area">
                    <textarea @ref="inputRef"
                              class="ai-input"
                              rows="1"
                              placeholder="π.χ. grass pollen, εκκρεμείς, alerts..."
                              @bind="currentInput"
                              @bind:event="oninput"
                              disabled="@isBusy"></textarea>
                    <button class="ai-send" title="Αποστολή" disabled="@(isBusy || string.IsNullOrWhiteSpace(currentInput))" @onclick="Send">➤</button>
                </div>
            </div>
        }

        <button class="ai-fab" title="SBT Suite Bot" @onclick="Toggle">
            @if (isOpen)
            {
                <span class="ai-fab-icon">✕</span>
            }
            else
            {
                <span class="ai-fab-icon">💬</span>
            }
        </button>
    </div>
}

@code {
    private bool isOpen;
    private bool isBusy;
    private string currentInput = "";
    private ElementReference messagesRef;
    private ElementReference inputRef;
    private IJSObjectReference module;
    private DotNetObjectReference<ChatBotWidget> dotnetRef;
    private bool inputWired;

    private readonly List<ChatMessage> messages = new()
    {
        new ChatMessage
        {
            Role = "assistant",
            Content = "Γεια σου! Είμαι ο βοηθός του SBT Suite. Ρώτα με για stock, παραγγελίες, γιατρούς ή αποστολές — γράψε «βοήθεια» για όλες τις εντολές."
        }
    };

    private readonly string[] suggestionChips =
    {
        "Stock alerts",
        "Εκκρεμείς παραγγελίες",
        "Αποστολές",
        "Βοήθεια"
    };

    private void Toggle()
    {
        isOpen = !isOpen;
        // Το textarea ξαναδημιουργείται σε κάθε άνοιγμα -- πρέπει να ξαναδεθεί το keydown
        inputWired = false;
    }

    protected override void OnInitialized()
    {
        dotnetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isOpen)
            return;

        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/ChatBotWidget.razor.js");

        if (!inputWired)
        {
            // Enter = αποστολή, Shift+Enter = νέα γραμμή (με preventDefault από JS)
            await module.InvokeVoidAsync("wireInput", inputRef, dotnetRef);
            inputWired = true;
        }

        await module.InvokeVoidAsync("scrollToBottom", messagesRef);
    }

    [JSInvokable]
    public async Task SendFromJs()
    {
        await InvokeAsync(Send);
    }

    private async Task SendChip(string chip)
    {
        currentInput = chip;
        await Send();
    }

    private async Task Send()
    {
        var text = currentInput?.Trim();
        if (string.IsNullOrEmpty(text) || isBusy)
            return;

        messages.Add(new ChatMessage { Role = "user", Content = text });
        currentInput = "";
        isBusy = true;
        StateHasChanged();

        // Ο DataService.Post δεν πιάνει network exceptions από το SendAsync --
        // χωρίς το try/catch ένα σκέτο σφάλμα δικτύου θα κράσαρε το widget.
        // (Το User model δεν έχει CompanyId, οπότε δεν στέλνεται εταιρεία.)
        ChatBotResponse response = null;
        try
        {
            response = await dataService.Post<ChatBotRequest, ChatBotResponse>(
                "api/chatbot/query",
                new ChatBotRequest { Message = text });
        }
        catch (Exception ex)
        {
            response = new ChatBotResponse { Reply = $"⚠️ Client error: {ex.Message}", Type = "error" };
        }

        // Μικρό delay για φυσική αίσθηση -- η απάντηση είναι ουσιαστικά instant
        await Task.Delay(300);

        messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = string.IsNullOrWhiteSpace(response?.Reply)
                ? "⚠️ Σφάλμα σύνδεσης. Δοκίμασε ξανά."
                : response.Reply
        });

        isBusy = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        dotnetRef?.Dispose();
        if (module != null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
