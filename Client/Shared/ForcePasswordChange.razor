@using StallmedManager.Shared.Models
@inject DataService dataService
@inject UserManager userManager

@* Παράθυρο υποχρεωτικής αλλαγής κωδικού. Δεν κλείνει και δεν έχει ✕:
   όσο ο χρήστης έχει τον κωδικό που του έδωσε ο admin, δεν προχωράει. *@
@if (userManager.MustChangePassword)
{
    <div class="pwd-overlay">
        <div class="pwd-box">
            <h5 class="mb-1">🔑 Άλλαξε τον κωδικό σου</h5>
            <p class="text-muted small mb-3">
                Μπήκες με τον προεπιλεγμένο κωδικό. Διάλεξε δικό σου για να συνεχίσεις.
            </p>

            <div class="mb-2">
                <label class="form-label mb-1 small">Τρέχων κωδικός</label>
                <input type="password" class="form-control" @bind="currentPassword" @bind:event="oninput" />
            </div>
            <div class="mb-2">
                <label class="form-label mb-1 small">Νέος κωδικός</label>
                <input type="password" class="form-control" @bind="newPassword" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label mb-1 small">Επανάληψη νέου κωδικού</label>
                <input type="password" class="form-control" @bind="repeatPassword" @bind:event="oninput"
                       @onkeydown="OnKeyDown" />
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-danger py-2 small">@message</div>
            }

            <button class="btn btn-primary w-100" @onclick="Submit" disabled="@(busy || !CanSubmit)">
                @(busy ? "Αποθήκευση..." : "Αποθήκευση κωδικού")
            </button>

            <div class="text-muted small mt-2">
                Τουλάχιστον 6 χαρακτήρες, διαφορετικός από τον προεπιλεγμένο.
            </div>
        </div>
    </div>
}

<style>
    .pwd-overlay {
        position: fixed; inset: 0; z-index: 2000;
        background: rgba(15, 23, 42, 0.65);
        display: flex; align-items: center; justify-content: center;
        padding: 16px;
    }

    .pwd-box {
        background: #fff; border-radius: 12px; padding: 22px;
        width: 100%; max-width: 380px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
</style>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string repeatPassword = "";
    private string message = "";
    private bool busy;

    private bool CanSubmit =>
        currentPassword.Length > 0 && newPassword.Length > 0 && repeatPassword.Length > 0;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSubmit && !busy)
            await Submit();
    }

    private async Task Submit()
    {
        message = "";

        if (newPassword != repeatPassword)
        {
            message = "Οι δύο νέοι κωδικοί δεν ταιριάζουν.";
            return;
        }

        busy = true;
        try
        {
            var result = await dataService.Post<ChangePasswordRequest, UserSaveResult>(
                "api/auth/change-password",
                new ChangePasswordRequest
                {
                    IdUser = userManager.User?.IdUser ?? 0,
                    CurrentPassword = currentPassword,
                    NewPassword = newPassword
                });

            if (result != null && result.Success)
            {
                await userManager.ClearPasswordChangeFlag();
                currentPassword = newPassword = repeatPassword = "";
            }
            else
            {
                message = result?.Message ?? "Η αλλαγή απέτυχε. Δοκίμασε ξανά.";
            }
        }
        catch (Exception ex)
        {
            message = $"Σφάλμα: {ex.Message}";
        }
        busy = false;
    }
}
