@inherits LayoutComponentBase
@inject UserManager userManager
@inject NavigationManager Navigation
@inject UiPreferencesService uiPrefs
@inject DataService dataService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JS
@inject NotificationsState notifications
@inject PushClientService push
@implements IDisposable
<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <a class="navbar-brand sbt-logo" href="/">
        <img src="images/sbt-suite-logo.svg" alt="SBT Suite" class="sbt-logo-icon" />
        <div class="sbt-logo-text">
            <span class="sbt-logo-bold">SBT</span>
            <span class="sbt-logo-light">Suite</span>
        </div>
    </a>
    <!-- Hamburger button για κινητό -->
    <button class="navbar-toggler" type="button" @onclick="ToggleMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
    <!-- Collapsible menu -->
    <div class="@MenuClass">
        <div class="navbar-nav me-auto">
            @if (!userManager.IsWarehouse)
            {
                <a class="nav-link" href="/" @onclick="CloseMenu">HOME</a>

                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        VACCINES
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="/orders" @onclick="CloseMenu">Orders</a></li>
                        <li><a class="dropdown-item" href="/doctors" @onclick="CloseMenu">Doctors</a></li>
                        <li><a class="dropdown-item" href="/stock-search" @onclick="CloseMenu">Stock</a></li>
                        <li><a class="dropdown-item" href="/treatment-stats" @onclick="CloseMenu">Mixes</a></li>
                    </ul>
                </div>
            }

            <div class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    PRICK
                </a>
                @* 3 εγγραφές αντί για 8: οι παλιές σελίδες ζουν ως καρτέλες μέσα στα
                   hubs Orders (/prick-orders) και Supply (/prick-supply) -- τα παλιά
                   routes παραμένουν ενεργά για bookmarks, απλώς δεν φαίνονται εδώ. *@
                <ul class="dropdown-menu dropdown-menu-dark">
                    <li><a class="dropdown-item" href="/apothema" @onclick="CloseMenu">Inventory</a></li>
                    <li><a class="dropdown-item" href="/prick-orders" @onclick="CloseMenu">Orders</a></li>
                    <li><a class="dropdown-item" href="/prick-supply" @onclick="CloseMenu">Supply</a></li>
                </ul>
            </div>

            @if (!userManager.IsWarehouse)
            {
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        TASKS
                        @if (myUnreadIssues > 0)
                        {
                            <span class="badge bg-danger ms-1" title="Θέματα που σε αφορούν και δεν τα έχεις δει ακόμα">🔔 @myUnreadIssues</span>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="/todo" @onclick="CloseMenu">Todo</a></li>
                        <li>
                            <a class="dropdown-item" href="/mytasks" @onclick="CloseMenu">
                                Issues
                                @if (myUnreadIssues > 0)
                                {
                                    <span class="badge bg-danger ms-1">@myUnreadIssues</span>
                                }
                            </a>
                        </li>
                        @* Visits μόνο για πωλητές + admin -- το ίδιο επιβάλλει και ο server. *@
                        @if (userManager.IsVendor || userManager.IsAdmin)
                        {
                            <li><a class="dropdown-item" href="/visits" @onclick="CloseMenu">Visits</a></li>
                        }
                        <li><a class="dropdown-item" href="/expenses" @onclick="CloseMenu">Εξοδολόγιο</a></li>
                        @* Διανομές σε γιατρούς (ημερολόγια κλπ.) -- για όλους *@
                        <li><a class="dropdown-item" href="/distributions" @onclick="CloseMenu">🎁 Διανομές</a></li>
                    </ul>
                </div>
            }

            @* Η δουλειά της ημέρας -- την βλέπουν όλοι. *@
            <div class="nav-item">
                <a class="nav-link" href="/daily-summary" @onclick="CloseMenu">📊 ΣΥΝΟΨΗ</a>
            </div>

            @* Παρακολούθηση Συσκευών: μόνο σε όσους έχουν πρόσβαση (admin ή TrackingUserAccess) --
               ο server ελέγχει ξανά σε κάθε κλήση. *@
            @if (canTrack)
            {
                <div class="nav-item">
                    <a class="nav-link" href="/tracking" @onclick="CloseMenu">📍 ΠΑΡΑΚΟΛΟΥΘΗΣΗ</a>
                </div>
            }

            @* Ορατό μόνο σε admin -- τα ίδια endpoints ελέγχονται και στον server. *@
            @if (userManager.IsAdmin)
            {
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        ADMIN
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="/users" @onclick="CloseMenu">Χρήστες</a></li>
                    </ul>
                </div>
            }
        </div>
        @if (userManager.IsLoggedIn)
        {
            <div class="d-flex flex-wrap align-items-center gap-3 ms-auto mt-2 mt-lg-0">
                <StartPageButton />
                <PushToggle />
                <label class="form-check-label text-white d-flex align-items-center gap-1" style="cursor:pointer;" title="Εμφανίζει επεξηγηματικές υποδείξεις (tooltips) πάνω από τα κουμπιά">
                    <input type="checkbox" class="form-check-input" checked="@uiPrefs.ShowHints" @onchange="OnShowHintsChanged" />
                    💡 Υποδείξεις
                </label>
                <span class="text-white">@userManager.User.Username</span>
                <span class="badge bg-success">@userManager.User.Role</span>
                <button class="btn btn-outline-light btn-sm" @onclick="Logout" title="Αποσύνδεση από τον λογαριασμό">Logout</button>
            </div>
        }
    </div>
</nav>
<div class="container-fluid mt-3">
    <CascadingValue Value="uiPrefs">
        @Body
    </CascadingValue>
</div>
<ChatBotWidget />
@* Σκεπάζει τα πάντα όσο ο χρήστης δεν έχει αλλάξει τον προεπιλεγμένο κωδικό *@
<ForcePasswordChange />
@code {
    private bool menuOpen = false;
    private string MenuClass => menuOpen
        ? "collapse navbar-collapse show"
        : "collapse navbar-collapse";
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
    // --- Σήμα ειδοποίησης για θέματα που μου ανατέθηκαν ---
    // Το Blazor WASM δεν δέχεται push, οπότε ρωτάμε τον server κάθε λεπτό.
    private int myUnreadIssues;
    // Κρατάμε τη στιγμή της τελευταίας κίνησης που έχουμε ήδη ειδοποιήσει, ώστε να
    // ανάβει και για νέο σχόλιο σε παλιό θέμα -- όχι μόνο για ολοκαίνουργιο θέμα.
    private DateTime? lastNotifiedActivity;
    private CancellationTokenSource? issuePollCts;

    private async Task PollIssuesAsync(CancellationToken token)
    {
        try { lastNotifiedActivity = await localStorage.GetItemAsync<DateTime?>("lastNotifiedActivity"); }
        catch (Exception) { lastNotifiedActivity = null; }

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            do
            {
                await CheckMyIssuesAsync();
            }
            while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) { /* αποσύνδεση ή κλείσιμο */ }
    }

    private Task CheckMyIssuesAsync() => CheckMyIssuesCoreAsync();

    // Επιστρέφει true αν βρέθηκε νέα κίνηση (και ειδοποιήθηκε η σελίδα Tasks να ανανεωθεί).
    private async Task<bool> CheckMyIssuesCoreAsync()
    {
        var userId = userManager.User?.IdUser;
        if (userId == null) return false;
        var newActivity = false;

        try
        {
            var summary = await new IssuesService(dataService).GetMySummary(userId.Value);
            if (summary == null) return false;

            myUnreadIssues = summary.UnreadCount;
            await push.SetBadgeAsync(myUnreadIssues);   // αριθμός πάνω στο εικονίδιο της εφαρμογής

            var activity = summary.NewestActivityAt;
            if (activity.HasValue && (lastNotifiedActivity == null || activity > lastNotifiedActivity))
            {
                // Πρώτα να ξέρουμε σίγουρα αν η συσκευή έχει push: χωρίς αυτή την αναμονή,
                // στο άνοιγμα της εφαρμογής ο έλεγχος προλάβαινε το push και έβγαινε διπλή.
                await InitPushAsync();

                // Την πρώτη φορά δεν ειδοποιούμε -- θα έβγαζε παλιές κινήσεις ως "νέες".
                // Με ενεργό push η ειδοποίηση έρχεται ήδη από τον server -- όχι δεύτερη.
                if (lastNotifiedActivity != null && !push.Active)
                {
                    var title = summary.NewestIsNewIssue
                        ? $"Νέο θέμα {summary.NewestIssueCode}"
                        : $"Νέο μήνυμα στο {summary.NewestIssueCode}";

                    // Χωριστό try: αν λείπει η βοηθητική JS (παλιό index.html από cache),
                    // το σήμα στο μενού πρέπει να συνεχίσει να δουλεύει κανονικά.
                    try
                    {
                        // Ίδιο tag με το push του server (issue-{id}): αν κάποτε βγουν και οι δύο,
                        // η μία αντικαθιστά την άλλη αντί να εμφανίζονται διπλές.
                        await JS.InvokeVoidAsync("sbtNotify.show", title, summary.NewestTitle ?? "",
                            $"/mytasks?issue={summary.NewestIssueID}", $"issue-{summary.NewestIssueID}");
                    }
                    catch (Exception) { }
                }
                // Όχι στον πρώτο έλεγχο: τότε η σελίδα μόλις φόρτωσε τα πάντα.
                newActivity = lastNotifiedActivity != null;
                lastNotifiedActivity = activity;
                await localStorage.SetItemAsync("lastNotifiedActivity", lastNotifiedActivity);
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { /* προσωρινό πρόβλημα δικτύου -- ξαναδοκιμάζει στο επόμενο λεπτό */ }

        // Η σελίδα Tasks (αν είναι ανοιχτή) ανανεώνει λίστα και συνομιλία.
        if (newActivity)
            await notifications.RaiseActivityChanged();
        return newActivity;
    }

    // Ο service worker έλαβε push: ανανέωση ΤΩΡΑ, όχι στον επόμενο έλεγχο του λεπτού.
    [JSInvokable]
    public async Task OnPushReceived()
    {
        // Αν το καμπανάκι δεν το είδε ως νέα κίνηση (π.χ. θέμα ομάδας που δεν μετράει
        // στο καμπανάκι), η σελίδα ανανεώνεται ούτως ή άλλως.
        if (!await CheckMyIssuesCoreAsync())
            await notifications.RaiseActivityChanged();
    }

    private DotNetObjectReference<MainLayout>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("sbtPush.onRefresh", selfRef); }
        catch (Exception) { /* παλιό index.html από cache -- απλώς χωρίς άμεση ανανέωση */ }
    }

    protected override async Task OnInitializedAsync()
    {
        issuePollCts = new CancellationTokenSource();
        _ = PollIssuesAsync(issuePollCts.Token);
        // Μόλις ο χρήστης διαβάσει κάτι, το καμπανάκι ενημερώνεται αμέσως.
        notifications.RefreshRequested += CheckMyIssuesAsync;

        userManager.StatusChanged += OnStatusChanged;
        await uiPrefs.Initialize();
        await InitPushAsync();
        await CheckTrackingAccessAsync();
    }

    // Εμφάνιση του «ΠΑΡΑΚΟΛΟΥΘΗΣΗ» μόνο σε όσους έχουν πρόσβαση (admin ή TrackingUserAccess).
    private bool canTrack;
    private async Task CheckTrackingAccessAsync()
    {
        if (!userManager.IsLoggedIn) { canTrack = false; return; }
        if (userManager.IsAdmin) { canTrack = true; return; }
        try { canTrack = (await new TrackingService(dataService).Me())?.CanView == true; }
        catch (Exception) { canTrack = false; }
    }

    // Μία φορά ανά χρήστη που συνδέεται (και ξανά μετά από logout/login).
    // Κρατάμε το Task, ώστε όποιος καλεί ενώ τρέχει ακόμα να περιμένει το ΙΔΙΟ αποτέλεσμα
    // και όχι να συνεχίζει νομίζοντας ότι η συσκευή δεν έχει push.
    private int? pushInitializedFor;
    private Task? pushInitTask;
    private Task InitPushAsync()
    {
        var userId = userManager.User?.IdUser;
        if (userId == null) return Task.CompletedTask;
        if (pushInitializedFor != userId || pushInitTask == null)
        {
            pushInitializedFor = userId;
            pushInitTask = push.InitializeAsync();
        }
        return pushInitTask;
    }

    private async Task OnShowHintsChanged(ChangeEventArgs e)
    {
        await uiPrefs.SetShowHints((bool)(e.Value ?? true));
        StateHasChanged();
    }

    // Οι μόνες σελίδες που επιτρέπονται στο role "warehouse".
    private static readonly string[] WarehouseAllowedPaths =
        { "/prick-dashboard", "/apothema", "/prick-orders", "/prick-supply", "/prick-doctor-orders", "/prick-production", "/prick-receiving", "/prick-shipments" };

    // Αυτό το layout instance επιβιώνει σε όλα τα navigations (μόνο το Body αλλάζει),
    // οπότε το OnParametersSet τρέχει σε κάθε αλλαγή route -- ιδανικό hook για route guard
    // χωρίς να χρειάζεται συνδρομή σε NavigationManager.LocationChanged.
    protected override void OnParametersSet()
    {
        if (!userManager.IsWarehouse) return;

        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        if (path.Equals("/login", StringComparison.OrdinalIgnoreCase)) return;

        if (!WarehouseAllowedPaths.Contains(path, StringComparer.OrdinalIgnoreCase))
            Navigation.NavigateTo("/apothema");
    }
    private void OnStatusChanged(object sender, EventArgs e)
    {
        _ = InvokeAsync(async () => { await CheckTrackingAccessAsync(); StateHasChanged(); });
        _ = InvokeAsync(InitPushAsync);
    }
    private async Task Logout()
    {
        // Πριν το logout, όσο υπάρχει ακόμα token για το αίτημα.
        await push.UnregisterAsync();
        await push.SetBadgeAsync(0);
        pushInitializedFor = null;
        pushInitTask = null;
        await userManager.Logout();
        Navigation.NavigateTo("/login");
    }
    public void Dispose()
    {
        userManager.StatusChanged -= OnStatusChanged;
        notifications.RefreshRequested -= CheckMyIssuesAsync;
        issuePollCts?.Cancel();
        issuePollCts?.Dispose();
        selfRef?.Dispose();
    }
}
