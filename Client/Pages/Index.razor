@page "/"
@using Blazored.LocalStorage
@using StallmedManager.Shared.Models
@using System
@inject DataService dataService
@inject ILocalStorageService localStorage
@inject NavigationManager navigationManager
@inject UserManager userManager
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<style>
    .filters-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .kpi-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 16px;
        text-align: center;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        height: 100%;
        cursor: default;
        position: relative;
        transition: box-shadow 0.2s;
    }

        .kpi-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.13);
        }

            .kpi-card:hover .kpi-tooltip {
                display: block;
            }

    .kpi-tooltip {
        display: none;
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: #fff;
        font-size: 0.75rem;
        padding: 6px 10px;
        border-radius: 6px;
        white-space: nowrap;
        z-index: 100;
        pointer-events: none;
    }

        .kpi-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: #333;
        }

    .kpi-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0d6efd;
    }

    .kpi-sep {
        color: #adb5bd;
        font-size: 1.3rem;
        font-weight: 400;
        margin: 0 4px;
    }

    .kpi-label {
        font-size: 0.90rem;
        color: #555;
        font-weight: 600;
        margin-top: 6px;
    }

    .server-toggle .btn {
        font-size: 0.85rem;
        padding: 4px 14px;
    }

    .chart-box {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    .product-bar-wrap {
        margin-bottom: 12px;
    }

    .product-bar-label {
        font-size: 0.85rem;
        margin-bottom: 3px;
        display: flex;
        justify-content: space-between;
    }

    .product-bar-bg {
        background: #e9ecef;
        border-radius: 6px;
        height: 14px;
        overflow: hidden;
    }

    .product-bar-fill {
        height: 100%;
        border-radius: 6px;
        transition: width 0.4s ease;
    }
</style>

<h1 class="mb-3">Home</h1>

<div class="filters-panel">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-4">
            <input id="fromDatePickerHome" class="form-control" placeholder="Από..." />
        </div>
        <div class="col-6 col-md-4">
            <input id="toDatePickerHome" class="form-control" placeholder="Έως..." />
        </div>
        <div class="col-12 col-md-4 server-toggle d-flex gap-2">
            <button class="btn w-100 @(serverFilter == "" ? "btn-dark" : "btn-outline-dark")"
                    @onclick='() => SetServerFilter("")' title="@Hint("Δείχνει στατιστικά και για τις δύο εταιρείες μαζί")">
                Όλα
            </button>
            <button class="btn w-100 @(serverFilter == "SM" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetServerFilter("SM")' title="@Hint("Φιλτράρει τα στατιστικά μόνο για StallMedicals")">
                SM
            </button>
            <button class="btn w-100 @(serverFilter == "BM" ? "btn-success" : "btn-outline-success")"
                    @onclick='() => SetServerFilter("BM")' title="@Hint("Φιλτράρει τα στατιστικά μόνο για BeltaMed")">
                BM
            </button>
        </div>
    </div>
</div>

@if (status == "loading")
{
    <p><em>Φορτώνω...</em></p>
}

@if (status == "loaded" && stats != null)
{
    <!-- Row 1: Κύρια KPIs -->
    <div class="row g-3 mb-3">

        <!-- Card 1: Παραγγελίες / Τεμάχια -->
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Αριθμός παραγγελιών και συνολικά τεμάχια στην επιλεγμένη περίοδο</div>
                <div class="kpi-value">
                    @stats.TotalOrders
                    <span class="kpi-sep">/</span>
                    @stats.TotalQNT
                </div>
                <div class="kpi-label">Παραγγελίες / Τεμάχια</div>
            </div>
        </div>

        <!-- Card 2: Ασθενείς / Νέοι -->
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Σύνολο ασθενών που παρήγγειλαν στην περίοδο / εκ των οποίων νέοι ασθενείς</div>
                <div class="kpi-value">
                    @stats.UniquePatients
                    <span class="kpi-sep">/</span>
                    <span style="color:#198754;">@stats.NewPatients</span>
                </div>
                <div class="kpi-label">Ασθενείς / Νέοι</div>
            </div>
        </div>

        <!-- Card 3: Προηγ. ΤΕΜ / Τάση -->
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Τεμάχια προηγούμενης ισόχρονης περιόδου / Τάση τεμαχίων vs προηγούμενη περίοδο</div>
                <div class="kpi-value">
                    @stats.PrevTotalQNT
                    <span class="kpi-sep">/</span>
                    <span style="color:@(stats.QNTTrendPercent >= 0 ? "#198754" : "#dc3545")">
                        @(stats.QNTTrendPercent >= 0 ? "▲" : "▼") @Math.Abs(stats.QNTTrendPercent)%
                    </span>
                </div>
                <div class="kpi-label">Προηγ. ΤΕΜ / Τάση</div>
            </div>
        </div>

        <!-- Card 4: Μερίδιο / Τάση -->
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Μερίδιο παραγγελιών επί συνόλου (@stats.TotalAllOrders Τεμ.) / Τάση μεριδίου vs προηγούμενη περίοδο</div>
                <div class="kpi-value">
                    @stats.SharePercent%
                    <span class="kpi-sep">/</span>
                    <span style="color:@(stats.TrendPercent >= 0 ? "#198754" : "#dc3545")">
                        @(stats.TrendPercent >= 0 ? "▲" : "▼") @Math.Abs(stats.TrendPercent)%
                    </span>
                </div>
                <div class="kpi-label">Μερίδιο (@stats.TotalAllOrders Τεμ.) / Τάση</div>
            </div>
        </div>

    </div>

    <!-- Row 2: Charts -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="chart-box">
                <h6 class="mb-3">Παραγγελίες ανά Μήνα</h6>
                <canvas id="barChartHome"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="chart-box">
                <h6 class="mb-3">Κατανομή ανά Προϊόν</h6>
                @{
                    var maxCount = stats.PerProduct.Any() ? stats.PerProduct.Max(x => x.Count) : 1;
                    var colors = new[] { "#4a90d9", "#e67e22", "#2ecc71", "#9b59b6", "#e74c3c", "#1abc9c", "#f39c12", "#3498db", "#d35400", "#27ae60" };
                }
                @foreach (var (product, idx) in stats.PerProduct.Select((p, i) => (p, i)))
                {
                    var pct = Math.Round((double)product.Count / maxCount * 100, 0);
                    var color = colors[idx % colors.Length];
                    <div class="product-bar-wrap">
                        <div class="product-bar-label">
                            <span style="color:#222;font-weight:500;">@product.Product</span>
                            <span style="color:#555;">@product.Count</span>
                        </div>
                        <div class="product-bar-bg">
                            <div class="product-bar-fill" style="width:@pct%;background-color:@color;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Row 3: Νέοι Polymerized -->
    @if (stats.PolymerizedProducts.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="chart-box">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h6 class="mb-0">Νέοι Polymerised</h6>
                        <span class="badge rounded-pill"
                              style="background:#9b59b6;font-size:0.78rem;">
                            @stats.NewPolymerizedPatients ασθ. / @stats.NewPolymerizedQNT τεμ.
                        </span>
                    </div>
                    @{
                        var maxPoly = stats.PolymerizedProducts.Max(x => x.Count);
                    }
                    @foreach (var product in stats.PolymerizedProducts)
                    {
                        var pct = Math.Round((double)product.Count / maxPoly * 100, 0);
                        <div class="product-bar-wrap">
                            <div class="product-bar-label">
                                <span style="color:#222;font-weight:500;">@product.Product</span>
                                <span style="color:#9b59b6;font-weight:600;">@product.Count</span>
                            </div>
                            <div class="product-bar-bg">
                                <div class="product-bar-fill"
                                     style="width:@pct%;background-color:#9b59b6;">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] public UiPreferencesService? UiPrefs { get; set; }
    private string? Hint(string text) => (UiPrefs?.ShowHints ?? true) ? text : null;

    private string status = "idle";
    private string serverFilter = "";
    private DateTime fromDate = DateTime.Today.AddMonths(-12);
    private DateTime toDate = DateTime.Today;
    private CompanyStats? stats = null;

    protected override async Task OnInitializedAsync()
    {
        // Δεν κάνουμε LoadStats εδώ
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initDatePicker", "fromDatePickerHome", dotNetRef, fromDate.ToString("dd/MM/yyyy"));
            await JS.InvokeVoidAsync("initDatePicker", "toDatePickerHome", dotNetRef, toDate.ToString("dd/MM/yyyy"));
            await LoadStats();
            return;
        }

        if (status == "loaded" && stats != null)
        {
            await Task.Delay(50);
            var barLabels = stats.PerMonth.Select(x => x.Month).ToArray();
            var barData = stats.PerMonth.Select(x => x.Count).ToArray();
            var prevLabels = stats.PerMonthPrev.Select(x => x.Month).ToArray();
            var prevData = stats.PerMonthPrev.Select(x => x.Count).ToArray();
            await JS.InvokeVoidAsync("renderBarChart", "barChartHome", barLabels, barData, prevLabels, prevData);
        }
    }

    [JSInvokable]
    public async Task SetDate(string elementId, string dateStr)
    {
        if (DateTime.TryParseExact(dateStr, "d/M/yyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date))
        {
            if (elementId == "fromDatePickerHome") fromDate = date;
            if (elementId == "toDatePickerHome") toDate = date;
            await LoadStats();
        }
    }

    private async Task SetServerFilter(string filter)
    {
        serverFilter = filter;
        await LoadStats();
    }

    private async Task LoadStats()
    {
        status = "loading";
        StateHasChanged();

        stats = await new OrdersService(dataService).GetCompanyStats("", serverFilter, fromDate, toDate);

        status = "loaded";
        StateHasChanged();
    }
}
