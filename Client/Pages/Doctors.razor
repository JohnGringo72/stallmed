@page "/doctors"
@using StallmedManager.Shared.Models
@using System
@inject DataService dataService
@inject IJSRuntime JS

<PageTitle>Γιατροί</PageTitle>

<style>
    .filters-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .kpi-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 16px;
        text-align: center;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        height: 100%;
        cursor: default;
        position: relative;
        transition: box-shadow 0.2s;
    }

        .kpi-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.13);
        }

            .kpi-card:hover .kpi-tooltip {
                display: block;
            }

    .kpi-tooltip {
        display: none;
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: #fff;
        font-size: 0.75rem;
        padding: 6px 10px;
        border-radius: 6px;
        white-space: nowrap;
        z-index: 100;
        pointer-events: none;
    }

        .kpi-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: #333;
        }

    .kpi-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0d6efd;
    }

    .kpi-sep {
        color: #adb5bd;
        font-size: 1.3rem;
        font-weight: 400;
        margin: 0 4px;
    }

    .kpi-label {
        font-size: 0.90rem;
        color: #555;
        font-weight: 600;
        margin-top: 6px;
    }

    .chart-box {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    .product-bar-wrap {
        margin-bottom: 12px;
    }

    .product-bar-label {
        font-size: 0.85rem;
        margin-bottom: 3px;
        display: flex;
        justify-content: space-between;
    }

    .product-bar-bg {
        background: #e9ecef;
        border-radius: 6px;
        height: 14px;
        position: relative;
        overflow: hidden;
    }

    .product-bar-fill {
        height: 100%;
        border-radius: 6px;
        transition: width 0.4s ease;
    }
</style>

<div class="sbt-page-header">
    <img src="images/sbt-suite-logo.svg" alt="" class="sbt-page-icon" />
    <h1 class="mb-3">Γιατροί</h1>
</div>

<div class="filters-panel">
    <div class="row g-2">
        <div class="col-6">
            <input id="fromDatePickerDoc" class="form-control" placeholder="Από..." />
        </div>
        <div class="col-6">
            <input id="toDatePickerDoc" class="form-control" placeholder="Έως..." />
        </div>
        <div class="col-8 col-md-10">
            <input class="form-control"
                   id="doctorInputDoc"
                   list="doctorListDoc"
                   value="@selectedDoctor"
                   @oninput="OnDoctorInput"
                   @onclick="OnDoctorClick"
                   placeholder="Αναζήτηση γιατρού..." />
            <datalist id="doctorListDoc">
                @foreach (var d in doctorOptions)
                {
                    <option value="@d">@d</option>
                }
            </datalist>
        </div>
        <div class="col-4 col-md-2">
            <button class="btn btn-primary w-100" @onclick="LoadStats" title="@Hint("Αναζήτηση στατιστικών για τον επιλεγμένο γιατρό στο διάστημα ημερομηνιών")">Search</button>
        </div>
    </div>
</div>

@if (status != "loaded" && summary.Any())
{
    <div class="chart-box mb-4">
        <h6 class="mb-3">Κατάταξη γιατρών (Εμβόλια στην περίοδο)</h6>
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Γιατρός</th>
                    <th class="text-end" style="cursor:pointer" @onclick='() => summarySortBy = "sm"'>SM @(summarySortBy == "sm" ? "▼" : "")</th>
                    <th class="text-end" style="cursor:pointer" @onclick='() => summarySortBy = "bm"'>BM @(summarySortBy == "bm" ? "▼" : "")</th>
                    <th class="text-end" style="cursor:pointer" @onclick='() => summarySortBy = "total"'>Total @(summarySortBy == "total" ? "▼" : "")</th>
                    <th class="text-end">Τάση</th>
                    <th class="text-end">Πρικ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (row, idx) in SortedSummary.Select((r, i) => (r, i)))
                {
                    <tr style="cursor:pointer" @onclick="() => SelectFromSummary(row.Doctor)">
                        <td>@(idx + 1)</td>
                        <td>@row.Doctor</td>
                        <td class="text-end">@row.QtySM</td>
                        <td class="text-end">@row.QtyBM</td>
                        <td class="text-end fw-bold">@row.QtyTotal</td>
                        <td class="text-end">
                            @if (row.PrevQtyTotal > 0)
                            {
                                var pct = Math.Round((double)(row.QtyTotal - row.PrevQtyTotal) / row.PrevQtyTotal * 100, 0);
                                var pctLabel = pct > 999 ? ">999%" : $"{Math.Abs(pct)}%";
                                <span style="color:@(pct >= 0 ? "#198754" : "#dc3545");white-space:nowrap;"
                                      title="Ίδια περίοδος πέρυσι: @row.PrevQtyTotal τεμ.">
                                    @pctLabel @(pct >= 0 ? "▲" : "▼")
                                </span>
                            }
                            else if (row.QtyTotal > 0)
                            {
                                <span style="color:#198754;" title="Χωρίς ποσότητα την ίδια περίοδο πέρυσι">νέο ▲</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (row.PrickQtyTotal.HasValue)
                            {
                                <span class="badge bg-info text-dark">@row.PrickQtyTotal</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (status == "loading")
{
    <p><em>Φορτώνω...</em></p>
}

@if (status == "loaded" && stats != null)
{
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Αριθμός παραγγελιών και συνολικά τεμάχια στην επιλεγμένη περίοδο</div>
                <div class="kpi-value">
                    @stats.TotalOrders
                    <span class="kpi-sep">/</span>
                    @stats.TotalQNT
                </div>
                <div class="kpi-label">Παραγγελίες / Τεμάχια</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Σύνολο ασθενών που παρήγγειλαν στην περίοδο / εκ των οποίων νέοι ασθενείς</div>
                <div class="kpi-value">
                    @stats.UniquePatients
                    <span class="kpi-sep">/</span>
                    <span style="color:#198754;">@stats.NewPatients</span>
                </div>
                <div class="kpi-label">Ασθενείς / Νέοι</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Τεμάχια προηγούμενης ισόχρονης περιόδου / Τάση τεμαχίων vs προηγούμενη περίοδο</div>
                <div class="kpi-value">
                    @stats.PrevTotalQNT
                    <span class="kpi-sep">/</span>
                    <span style="color:@(stats.QNTTrendPercent >= 0 ? "#198754" : "#dc3545")">
                        @(stats.QNTTrendPercent >= 0 ? "▲" : "▼") @Math.Abs(stats.QNTTrendPercent)%
                    </span>
                </div>
                <div class="kpi-label">Προηγ. ΤΕΜ / Τάση</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-tooltip">Μερίδιο παραγγελιών επί συνόλου (@stats.TotalAllOrders Τεμ.) / Τάση μεριδίου vs προηγούμενη περίοδο</div>
                <div class="kpi-value">
                    @stats.SharePercent%
                    <span class="kpi-sep">/</span>
                    <span style="color:@(stats.TrendPercent >= 0 ? "#198754" : "#dc3545")">
                        @(stats.TrendPercent >= 0 ? "▲" : "▼") @Math.Abs(stats.TrendPercent)%
                    </span>
                </div>
                <div class="kpi-label">Μερίδιο (@stats.TotalAllOrders Τεμ.) / Τάση</div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="chart-box">
                <h6 class="mb-3">Παραγγελίες ανά Μήνα</h6>
                <canvas id="barChart"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="chart-box">
                <h6 class="mb-3">Κατανομή ανά Προϊόν</h6>
                @{
                    var maxCount = stats.PerProduct.Any() ? stats.PerProduct.Max(x => x.Count) : 1;
                    var colors = new[] { "#4a90d9", "#e67e22", "#2ecc71", "#9b59b6", "#e74c3c", "#1abc9c", "#f39c12", "#3498db", "#d35400", "#27ae60" };
                }
                @foreach (var (product, idx) in stats.PerProduct.Select((p, i) => (p, i)))
                {
                    var pct = Math.Round((double)product.Count / maxCount * 100, 0);
                    var color = colors[idx % colors.Length];
                    <div class="product-bar-wrap">
                        <div class="product-bar-label">
                            <span style="color:#222;font-weight:500;">@product.Product</span>
                            <span style="color:#555;">@product.Count</span>
                        </div>
                        <div class="product-bar-bg">
                            <div class="product-bar-fill" style="width:@pct%;background-color:@color;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public UiPreferencesService? UiPrefs { get; set; }
    private string? Hint(string text) => (UiPrefs?.ShowHints ?? true) ? text : null;

    private string status = "idle";
    private string selectedDoctor = "";
    private DateTime fromDate = DateTime.Today.AddMonths(-12);
    private DateTime toDate = DateTime.Today;
    private List<string> doctorOptions = new();
    private DoctorStats? stats = null;
    private List<DoctorSummaryRow> summary = new();
    private string summarySortBy = "total";

    private IEnumerable<DoctorSummaryRow> SortedSummary => summarySortBy switch
    {
        "sm" => summary.OrderByDescending(r => r.QtySM),
        "bm" => summary.OrderByDescending(r => r.QtyBM),
        _ => summary.OrderByDescending(r => r.QtyTotal)
    };

    protected override async Task OnInitializedAsync()
    {
        var options = await new OrdersService(dataService).GetFilterOptions();
        doctorOptions = options.Doctors;
        await LoadSummary();
    }

    private async Task LoadSummary()
    {
        summary = await new OrdersService(dataService).GetDoctorSummary(fromDate, toDate);
        StateHasChanged();
    }

    private async Task SelectFromSummary(string doctor)
    {
        selectedDoctor = doctor;
        await LoadStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initDatePicker", "fromDatePickerDoc", dotNetRef, fromDate.ToString("dd/MM/yyyy"));
            await JS.InvokeVoidAsync("initDatePicker", "toDatePickerDoc", dotNetRef, toDate.ToString("dd/MM/yyyy"));
            StateHasChanged();
        }

        if (status == "loaded" && stats != null)
        {
            await Task.Delay(50);
            var barLabels = stats.PerMonth.Select(x => x.Month).ToArray();
            var barData = stats.PerMonth.Select(x => x.Count).ToArray();
            var prevLabels = stats.PerMonthPrev.Select(x => x.Month).ToArray();
            var prevData = stats.PerMonthPrev.Select(x => x.Count).ToArray();
            await JS.InvokeVoidAsync("renderBarChart", "barChart", barLabels, barData, prevLabels, prevData);
        }
    }

    [JSInvokable]
    public async Task SetDate(string elementId, string dateStr)
    {
        if (DateTime.TryParseExact(dateStr, "d/M/yyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date))
        {
            if (elementId == "fromDatePickerDoc") fromDate = date;
            if (elementId == "toDatePickerDoc") toDate = date;
            StateHasChanged();
            await LoadSummary();
        }
    }

    private async Task OnDoctorInput(ChangeEventArgs e)
    {
        selectedDoctor = e.Value?.ToString() ?? "";
        if (doctorOptions.Contains(selectedDoctor))
        {
            await LoadStats();
        }
        else if (string.IsNullOrEmpty(selectedDoctor))
        {
            // Άδειασμα πεδίου γιατρού -> επιστροφή στην κατάταξη
            stats = null;
            status = "idle";
        }
    }

    private async Task LoadStats()
    {
        if (string.IsNullOrEmpty(selectedDoctor)) return;

        status = "loading";
        StateHasChanged();

        stats = await new OrdersService(dataService).GetDoctorStats(selectedDoctor, fromDate, toDate);

        status = "loaded";
        StateHasChanged();
    }
    private async Task OnDoctorClick()
    {
        await JS.InvokeVoidAsync("selectAll", "doctorInputDoc");
    }
}