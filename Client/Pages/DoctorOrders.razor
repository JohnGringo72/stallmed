    private async Task SubmitQuickAddDoctor()
    {
        if (string.IsNullOrWhiteSpace(quickAddName))
        {
            newOrderMessage = "Συμπλήρωσε το ονοματεπώνυμο του γιατρού.";
            return;
        }
        var req = new QuickAddDoctorRequest
        {
            FullName = quickAddName,
            Phone = quickAddPhone,
            City = quickAddCity,
            CreatedBy = userManager.User?.IdUser
        };
        var result = await new PrickDoctorOrderService(dataService).QuickAddDoctor(req);
        if (result != null)
        {
            selectedDoctor = result;
            showQuickAddDoctor = false;
        }
        else
        {
            newOrderMessage = "Απέτυχε η δημιουργία γιατρού.";
        }
    }

    private async Task SubmitNewOrder()
    {
        if (string.IsNullOrEmpty(newOrderCompany))
        {
            newOrderMessage = "Επίλεξε εταιρεία.";
            return;
        }
        if (string.IsNullOrEmpty(newOrderProductType))
        {
            newOrderMessage = "Επίλεξε τύπο για την παραγγελία.";
            return;
        }
        if (selectedDoctor == null)
        {
            newOrderMessage = "Επίλεξε ή δημιούργησε γιατρό.";
            return;
        }
        var validLines = newOrderLines
            .Where(l => !string.IsNullOrEmpty(l.SelectedCode) && l.Quantity > 0)
            .Select(l => new CreateDoctorOrderLineRequest
            {
                CodePrick = l.SelectedCode,
                ProductTypeCode = newOrderProductType,
                QuantityRequested = l.Quantity
            })
            .ToList();
        if (validLines.Count == 0)
        {
            newOrderMessage = "Πρόσθεσε τουλάχιστον ένα έγκυρο αλλεργιογόνο.";
            return;
        }

        var req = new CreateDoctorOrderRequest
        {
            Company = newOrderCompany,
            DoctorID = selectedDoctor.DoctorID,
            OrderDate = newOrderDate,
            CreatedBy = userManager.User?.IdUser,
            Lines = validLines
        };

        var result = await new PrickDoctorOrderService(dataService).CreateOrder(req);
        if (result != null)
        {
            successMessage = $"Η παραγγελία {result.OrderCode} καταχωρήθηκε επιτυχώς!";
            await LoadData();
        }
        else
        {
            newOrderMessage = "Κάτι πήγε στραβά, δοκίμασε ξανά.";
        }
    }
}
