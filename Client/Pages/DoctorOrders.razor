<!-- ================= CONFIRMATION POPUP (μη-αναστρέψιμες ενέργειες) ================= -->
@if (showConfirm)
{
    <div class="popup-overlay" @onclick="CloseConfirm">
        <div class="popup-box" style="max-width:420px;" @onclick:stopPropagation="true">
            <p class="mb-3">@confirmMessage</p>
            <div class="d-flex gap-2">
                <button class="btn btn-secondary flex-fill" @onclick="CloseConfirm">Ακύρωση</button>
                <button class="btn btn-danger flex-fill" @onclick="RunConfirmedAction">Ναι, συνέχεια</button>
            </div>
        </div>
    </div>
}

@code {
    private string selectedCompany = "";
    private string selectedStatus = "Open";
    private string searchOrderCode = "";
    private string status = "idle";
    private string topBannerMessage = "";
    private List<DoctorOrderViewDto> orders = new();
    private string? expandedDoctor = null;
    private string? expandedOrder = null;

    private string doctorSortBy = "date";

    // --- Confirmation popup (μη-αναστρέψιμες ενέργειες πάνω σε παραγγελία) ---
    private bool showConfirm = false;
    private string confirmMessage = "";
    private Func<Task>? confirmAction;

    private void ShowConfirm(string message, Func<Task> action)
    {
        confirmMessage = message;
        confirmAction = action;
        showConfirm = true;
    }

    private void CloseConfirm()
    {
        showConfirm = false;
        confirmAction = null;
    }

    private async Task RunConfirmedAction()
    {
        var action = confirmAction;
        showConfirm = false;
        confirmAction = null;
        if (action != null)
            await action();
    }

    private void ConfirmSaveOrderChanges(DoctorOrderViewDto order, int changeCount) =>
        ShowConfirm($"Θέλεις να αποθηκεύσεις {changeCount} αλλαγές στην παραγγελία {order.OrderCode};", () => SaveOrderChanges(order));

    private void ConfirmForceComplete(DoctorOrderViewDto order) =>
        ShowConfirm($"Θέλεις να κλείσεις οριστικά την παραγγελία {order.OrderCode} ως ολοκληρωμένη; Αυτή η ενέργεια δεν αναιρείται.", () => DoForceComplete(order));

    private void ConfirmSplitPending(DoctorOrderViewDto order) =>
        ShowConfirm($"Θέλεις να διαχωρίσεις την παραγγελία {order.OrderCode}; Θα δημιουργηθεί νέα παραγγελία για το εκκρεμές υπόλοιπο.", () => DoSplitPending(order));

    private void ConfirmCancelLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line, int pending) =>
        ShowConfirm($"Θέλεις να ακυρώσεις το εκκρεμές υπόλοιπο του {line.CodePrick} ({pending} τεμ.);", () =>
        {
            ToggleCancelLine(order, line);
            return Task.CompletedTask;
        });

    private void ConfirmRemoveLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line) =>
        ShowConfirm($"Θέλεις να αφαιρέσεις το {line.CodePrick} από την παραγγελία;", () =>
        {
            ToggleRemoveLine(order, line);
            return Task.CompletedTask;
        });

    private List<SimpleCodeOptionDto> allergenOptions = new();
    private List<SimpleCodeOptionDto> productTypeOptions = new();

    private string stockCheckQuery = "";
    private List<StockCheckDto> stockCheckResults = new();
    private CancellationTokenSource? stockCheckDebounce;

    private bool showNewOrderPopup = false;
    private string newOrderCompany = "";
    private string newOrderProductType = "";
    private DateTime newOrderDate = DateTime.Today;
    private string newOrderMessage = "";
    private string successMessage = "";
    private string newOrderAllergenFilter = "";
    private Dictionary<string, int> newOrderQtyMap = new();

    private List<SimpleCodeOptionDto> FilteredNewOrderAllergens =>
        allergenOptions
            .Where(a => string.IsNullOrEmpty(newOrderAllergenFilter) ||
                        a.Code.Contains(newOrderAllergenFilter, StringComparison.OrdinalIgnoreCase) ||
                        (a.DescriptionGreek?.Contains(newOrderAllergenFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(a => a.Code)
            .ToList();

    private int GetNewOrderQty(string code) =>
        newOrderQtyMap.TryGetValue(code, out var q) ? q : 0;

    private void ChangeNewOrderQty(string code, int delta)
    {
        var current = GetNewOrderQty(code);
        var updated = current + delta;
        if (updated < 0) updated = 0;
        if (updated == 0) newOrderQtyMap.Remove(code);
        else newOrderQtyMap[code] = updated;
    }

    private string doctorSearchQuery = "";
    private List<DoctorOptionDto> doctorSearchResults = new();
    private DoctorOptionDto? selectedDoctor;
    private CancellationTokenSource? doctorSearchDebounce;

    private bool showQuickAddDoctor = false;
    private string quickAddName = "";
    private string quickAddPhone = "";
    private string quickAddCity = "";

    // --- Batch edit mode: pending changes ανά παραγγελία ---
    private class PendingOrderChanges
    {
        public Dictionary<long, int> Allocations { get; set; } = new(); // lineId → qty
        public HashSet<long> Cancellations { get; set; } = new();        // lineIds προς ακύρωση
        public HashSet<long> Uncancellations { get; set; } = new();      // lineIds προς αναίρεση
        public HashSet<long> Reversals { get; set; } = new();            // lineIds προς ανάκληση
        public List<(string Code, int Qty)> AddLines { get; set; } = new();
        public HashSet<long> RemoveLines { get; set; } = new();          // lineIds προς αφαίρεση
        public string? Notes { get; set; }
        public bool HasChanges => Allocations.Any() || Cancellations.Any() || Uncancellations.Any() ||
                                  Reversals.Any() || AddLines.Any() || RemoveLines.Any() || Notes != null;
        public int ChangeCount => Allocations.Count + Cancellations.Count + Uncancellations.Count +
                                  Reversals.Count + AddLines.Count + RemoveLines.Count + (Notes != null ? 1 : 0);
    }
    private Dictionary<long, PendingOrderChanges> pendingChanges = new(); // key = OrderID
    private Dictionary<string, string> allergenDescCache = new();

    private PendingOrderChanges GetPending(long orderId)
    {
        if (!pendingChanges.TryGetValue(orderId, out var p))
        {
            p = new PendingOrderChanges();
            pendingChanges[orderId] = p;
        }
        return p;
    }

    private string GetAllergenDesc(string code) =>
        allergenDescCache.TryGetValue(code, out var d) ? d : code;

    private int GetAllocateQty(DoctorOrderViewDto order, DoctorOrderLineViewDto line)
    {
        var p = GetPending(order.OrderID);
        return p.Allocations.TryGetValue(line.OrderLineID, out var q) ? q : 0;
    }

    private void ChangeAllocateQty(DoctorOrderViewDto order, DoctorOrderLineViewDto line, int delta)
    {
        var p = GetPending(order.OrderID);
        var pending = line.QuantityRequested - line.QuantityAllocated - line.QuantityCancelled;
        var max = Math.Max(0, Math.Min(pending, line.AvailableStock));
        var updated = Math.Clamp(GetAllocateQty(order, line) + delta, 0, max);
        if (updated == 0) p.Allocations.Remove(line.OrderLineID);
        else p.Allocations[line.OrderLineID] = updated;
    }

    private void ToggleCancelLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line)
    {
        var p = GetPending(order.OrderID);
        if (!p.Cancellations.Remove(line.OrderLineID))
            p.Cancellations.Add(line.OrderLineID);
    }

    private void ToggleUncancelLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line)
    {
        var p = GetPending(order.OrderID);
        if (!p.Uncancellations.Remove(line.OrderLineID))
            p.Uncancellations.Add(line.OrderLineID);
    }

    private void ToggleReverseLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line)
    {
        var p = GetPending(order.OrderID);
        if (!p.Reversals.Remove(line.OrderLineID))
            p.Reversals.Add(line.OrderLineID);
    }

    private void ToggleRemoveLine(DoctorOrderViewDto order, DoctorOrderLineViewDto line)
    {
        var p = GetPending(order.OrderID);
        if (!p.RemoveLines.Remove(line.OrderLineID))
