    private void OnAddLineSearch(DoctorOrderViewDto order, string value)
    {
        addLineSearchQuery = value;
        addLineSelectedCode = null;
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            addLineSuggestions = new();
            return;
        }
        addLineSuggestions = addLineAllergenOptions.Where(a =>
                (a.Code?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.DescriptionGreek?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Description?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(8)
            .ToList();
    }

