    private void DiscardOrderChanges(DoctorOrderViewDto order) => pendingChanges.Remove(order.OrderID);

    private async Task SaveOrderChanges(DoctorOrderViewDto order)
    {
        if (!pendingChanges.TryGetValue(order.OrderID, out var p) || !p.HasChanges) return;

        var allocSvc = new PrickAllocationService(dataService);
        var orderSvc = new PrickDoctorOrderService(dataService);
        var userId = userManager.User?.IdUser;

        foreach (var kv in p.Allocations)
            await allocSvc.Allocate(new AllocateRequest { OrderLineID = kv.Key, Quantity = kv.Value, UserID = userId });

        foreach (var lineId in p.Cancellations)
            await orderSvc.CancelLine(new CancelLineRequest { OrderLineID = lineId, UserID = userId });

        foreach (var lineId in p.Uncancellations)
            await orderSvc.UncancelLine(new UncancelLineRequest { OrderLineID = lineId, UserID = userId });

        foreach (var lineId in p.Reversals)
            await orderSvc.ReverseLine(new ReverseLineRequest { OrderLineID = lineId, UserID = userId });

        foreach (var add in p.AddLines)
            await orderSvc.AddLine(new AddOrderLineRequest { OrderID = order.OrderID, CodePrick = add.Code, Quantity = add.Qty });

        foreach (var lineId in p.RemoveLines)
            await orderSvc.RemoveLine(new RemoveOrderLineRequest { OrderLineID = lineId });

        if (p.Notes != null)
            await orderSvc.UpdateNotes(new UpdateNotesRequest { OrderID = order.OrderID, Notes = p.Notes });

        pendingChanges.Remove(order.OrderID);
        topBannerMessage = $"✅ Αποθηκεύτηκαν οι αλλαγές της παραγγελίας {order.OrderCode}.";
        await LoadData();
    }

