    private async Task SubmitNewOrder()
    {
        if (string.IsNullOrEmpty(newOrderCompany))
        {
            newOrderMessage = "Επίλεξε εταιρεία.";
            return;
        }
        if (string.IsNullOrEmpty(newOrderProductType))
        {
            newOrderMessage = "Επίλεξε τύπο για την παραγγελία.";
            return;
        }
        if (selectedDoctor == null)
        {
            newOrderMessage = "Επίλεξε ή δημιούργησε γιατρό.";
            return;
        }
        var validLines = newOrderQtyMap
            .Where(kv => kv.Value > 0)
            .Select(kv => new CreateDoctorOrderLineRequest
            {
                CodePrick = kv.Key,
                ProductTypeCode = newOrderProductType,
                QuantityRequested = kv.Value
            })
            .ToList();
        if (validLines.Count == 0)
        {
            newOrderMessage = "Πρόσθεσε τουλάχιστον ένα αλλεργιογόνο (ποσότητα > 0).";
            return;
        }
        var req = new CreateDoctorOrderRequest
        {
            Company = newOrderCompany,
            DoctorID = selectedDoctor.DoctorID,
            OrderDate = newOrderDate,
            CreatedBy = userManager.User?.IdUser,
            RecipientName = string.IsNullOrWhiteSpace(newOrderRecipientName) ? null : newOrderRecipientName,
            ShippingAddress = string.IsNullOrWhiteSpace(newOrderShippingAddress) ? null : newOrderShippingAddress,
            ShippingCity = string.IsNullOrWhiteSpace(newOrderShippingCity) ? null : newOrderShippingCity,
            ShippingPostalCode = string.IsNullOrWhiteSpace(newOrderShippingPostalCode) ? null : newOrderShippingPostalCode,
            ShippingPhone = string.IsNullOrWhiteSpace(newOrderShippingPhone) ? null : newOrderShippingPhone,
            InvoiceType = newOrderInvoiceType,
            InvoiceNote = string.IsNullOrWhiteSpace(newOrderInvoiceNote) ? null : newOrderInvoiceNote,
            Lines = validLines
        };
        var result = await new PrickDoctorOrderService(dataService).CreateOrder(req);
        if (result != null)
        {
            successMessage = $"Η παραγγελία {result.OrderCode} καταχωρήθηκε επιτυχώς!";
            await LoadData();
        }
        else
        {
            newOrderMessage = "Κάτι πήγε στραβά, δοκίμασε ξανά.";
        }
    }

    // ===================== Allocate =====================
    private async Task DoBulkAllocate(DoctorOrderViewDto order)
    {
        var svc = new PrickAllocationService(dataService);
        int linesProcessed = 0, totalAllocated = 0;

        foreach (var line in order.Lines)
        {
            var pending = line.QuantityRequested - line.QuantityAllocated - line.QuantityCancelled;
            var toAllocate = Math.Min(pending, line.AvailableStock);
            if (toAllocate <= 0) continue;

            var req = new AllocateRequest { OrderLineID = line.OrderLineID, Quantity = toAllocate, UserID = userManager.User?.IdUser };
            var result = await svc.Allocate(req);
            if (result != null)
            {
                linesProcessed++;
                totalAllocated += result.QuantityActuallyAllocated;
            }
        }

        topBannerMessage = linesProcessed > 0
            ? $"✅ Δεσμεύτηκαν συνολικά {totalAllocated} τεμάχια σε {linesProcessed} γραμμές της παραγγελίας {order.OrderCode}."
            : "Δεν υπήρχε τίποτα διαθέσιμο για δέσμευση.";
        pendingChanges.Remove(order.OrderID);
        await LoadData();
    }

