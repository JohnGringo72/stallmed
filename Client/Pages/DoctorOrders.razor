    private async Task SubmitSteal()
    {
        if (elsewhereLine == null || selectedElsewhere == null) return;
        if (stealQuantity <= 0 || stealQuantity > selectedElsewhere.QuantityAllocated)
        {
            elsewhereMessage = "Μη έγκυρη ποσότητα.";
            return;
        }
        var req = new StealRequest
        {
            SourceAllocationID = selectedElsewhere.AllocationID,
            Quantity = stealQuantity,
            TargetOrderLineID = elsewhereLine.OrderLineID,
            UserID = userManager.User?.IdUser
        };
        var result = await new PrickDoctorOrderService(dataService).Steal(req);
        if (result != null && result.Success)
        {
            showElsewherePopup = false;
            await LoadData();
        }
        else
        {
            elsewhereMessage = result?.Message ?? "Κάτι πήγε στραβά, δοκίμασε ξανά.";
        }
    }

