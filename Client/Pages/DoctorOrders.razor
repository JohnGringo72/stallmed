    private class DoctorGroup
    {
        public string DoctorName { get; set; }
        public List<DoctorOrderViewDto> Orders { get; set; } = new();
        public int TotalOrders => Orders.Count;
        public int TotalPending => Orders.Sum(o => o.Lines.Sum(l => l.QuantityRequested - l.QuantityAllocated - l.QuantityCancelled));
        public DateTime LastOrderDate => Orders.Max(o => o.OrderDate);
    }

    private List<DoctorGroup> DoctorGroups =>
        orders
            .Where(o => string.IsNullOrEmpty(searchOrderCode) ||
                        o.OrderCode.Contains(searchOrderCode, StringComparison.OrdinalIgnoreCase) ||
                        (o.DoctorName?.Contains(searchOrderCode, StringComparison.OrdinalIgnoreCase) ?? false))
            .GroupBy(o => o.DoctorName ?? "—")
            .Select(g => new DoctorGroup { DoctorName = g.Key, Orders = g.ToList() })
            .ToList();

    private class OrdersSummaryStats
    {
        public int TotalOrders { get; set; }
        public int TotalRequested { get; set; }
        public int TotalAvailable { get; set; }
        public int TotalPending { get; set; }
        public int NoStock { get; set; }
    }

    private OrdersSummaryStats SummaryStats
    {
        get
        {
            var visibleOrders = DoctorGroups.SelectMany(g => g.Orders).ToList();
            var allLines = visibleOrders.SelectMany(o => o.Lines).ToList();
            return new OrdersSummaryStats
            {
                TotalOrders = visibleOrders.Count,
                TotalRequested = allLines.Sum(l => l.QuantityRequested),
                TotalAvailable = allLines.Sum(l => Math.Min(l.QuantityRequested - l.QuantityAllocated - l.QuantityCancelled, l.AvailableStock)),
                TotalPending = allLines.Sum(l => l.QuantityRequested - l.QuantityAllocated - l.QuantityCancelled),
                NoStock = visibleOrders.Count(o =>
                    o.Lines.Sum(l => l.QuantityRequested - l.QuantityAllocated - l.QuantityCancelled) > 0 &&
                    o.Lines.All(l => l.AvailableStock == 0))
            };
        }
    }

    private List<DoctorGroup> SortedDoctorGroups
    {
        get
        {
            IEnumerable<DoctorGroup> groups = DoctorGroups;
            groups = doctorSortBy switch
            {
                "count" => groups.OrderByDescending(g => g.TotalOrders),
                "pending" => groups.OrderByDescending(g => g.TotalPending),
                "name" => groups.OrderBy(g => g.DoctorName),
                _ => groups.OrderByDescending(g => g.LastOrderDate)
            };
            return groups.ToList();
        }
    }

