    }

    private void SubmitAddLine(DoctorOrderViewDto order)
    {
        if (string.IsNullOrEmpty(addLineSelectedCode) || addLineQuantity <= 0)
        {
            addLineMessage = "Διάλεξε αλλεργιογόνο και έγκυρη ποσότητα.";
            return;
        }
        if (order.Lines.Any(l => l.CodePrick == addLineSelectedCode))
        {
            addLineMessage = "Αυτός ο κωδικός υπάρχει ήδη σε αυτή την παραγγελία.";
            return;
        }
        var p = GetPending(order.OrderID);
        if (p.AddLines.Any(a => a.Code == addLineSelectedCode))
        {
            addLineMessage = "Αυτός ο κωδικός υπάρχει ήδη στις εκκρεμείς προσθήκες.";
            return;
        }
        p.AddLines.Add((addLineSelectedCode, addLineQuantity));
        showAddLineFor.Remove(order.OrderID);
    }

