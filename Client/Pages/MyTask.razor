            {
                await push.SendTestAsync();
            }
            notifyPermission = await JS.InvokeAsync<string>("sbtNotify.permission");
            if (notifyPermission == "default")
                notifyPermission = await JS.InvokeAsync<string>("sbtNotify.request");
        }
        catch (Exception)
        {
            notifyPermission = "unsupported";
            notifyMessage = "Κάνε ανανέωση με Ctrl+F5 και ξαναδοκίμασε.";
