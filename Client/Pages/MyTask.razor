                });
            pendingFiles.Clear();
            fileMessage = "";
            firstComment = "";
            busy = false;
        }

        showEdit = false;
        await Load();
        // Αν η επεξεργασία έγινε από τα details, φρεσκάρισμα του ανοιχτού παραθύρου·
        // αλλιώς άνοιγμα του νέου θέματος για άμεσο έλεγχο.
        if (details != null && editId != null)
            details = await Service.GetIssue(editId.Value, userManager.User?.IdUser);
        else if (editId == null)
            details = await Service.GetIssue(result.IssueID, userManager.User?.IdUser);
    }

    // ---- Αρχεία: προετοιμασία πριν το ανέβασμα ----
    // Οι φωτογραφίες του κινητού (3-12 MB) μικραίνουν στη συσκευή σε JPEG έως 1920px
    // (~300-700 KB), όπως κάνουν Viber/WhatsApp: ανεβαίνουν γρήγορα και δεν φουσκώνει η βάση.
    // Τα υπόλοιπα (PDF, Excel κλπ.) ανεβαίνουν όπως είναι, μέχρι το όριο.
    private const long MaxFileBytes = 15 * 1024 * 1024;
    private const int MaxFilesAtOnce = 20;
    private const int MaxImageSide = 1920;
    private bool preparingFiles;
    private string fileMessage = "";

    // ΜΟΝΟ τύποι που ανοίγει κάθε browser. Το RequestImageFileAsync του Blazor, αν ο browser
    // δεν μπορεί να ανοίξει την εικόνα (π.χ. TIFF, HEIC σε Android), δεν βγάζει σφάλμα --
    // περιμένει για πάντα. GIF (χάνει την κίνηση) και SVG μένουν επίσης όπως είναι.
    private static readonly string[] ResizableTypes = { "image/jpeg", "image/png", "image/webp", "image/bmp" };
    private static readonly TimeSpan ResizeTimeout = TimeSpan.FromSeconds(15);

    private static bool IsResizableImage(IBrowserFile file) =>
        ResizableTypes.Contains(file.ContentType?.ToLowerInvariant() ?? "");

    private static string MegaBytes(long bytes) => (bytes / 1024.0 / 1024.0).ToString("0.#");

    // Επιστρέφει το αρχείο έτοιμο για ανέβασμα, ή μήνυμα λάθους για τον χρήστη.
    private async Task<(PendingFile? File, string? Error)> PrepareFileAsync(IBrowserFile file)
    {
        if (IsResizableImage(file))
        {
            try
            {
                // Δικλείδα: αν η σμίκρυνση δεν τελειώσει εγκαίρως, ανεβαίνει η αρχική.
                var resizeTask = file.RequestImageFileAsync("image/jpeg", MaxImageSide, MaxImageSide).AsTask();
                if (await Task.WhenAny(resizeTask, Task.Delay(ResizeTimeout)) == resizeTask)
                {
                    var resized = await resizeTask;
                    using var rs = new MemoryStream();
                    await resized.OpenReadStream(MaxFileBytes).CopyToAsync(rs);
                    // Μικρή εικόνα που θα μεγάλωνε ως JPEG (π.χ. screenshot): κρατάμε την αρχική.
                    if (rs.Length > 0 && rs.Length < file.Size)
                        return (new PendingFile(Path.ChangeExtension(file.Name, ".jpg"), rs.ToArray()), null);
                }
            }
            catch (Exception)
            {
                // Ο browser δεν μπόρεσε να τη μικρύνει (π.χ. HEIC σε Android): ανεβαίνει η αρχική.
            }
        }

        if (file.Size > MaxFileBytes)
            return (null, $"Το «{file.Name}» είναι {MegaBytes(file.Size)} MB -- το όριο είναι {MegaBytes(MaxFileBytes)} MB.");

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxFileBytes).CopyToAsync(ms);
            return (new PendingFile(file.Name, ms.ToArray()), null);
        }
        catch (Exception)
        {
            return (null, $"Δεν διαβάστηκε το «{file.Name}».");
        }
    }

    // Το InputFile πετάει εξαίρεση αν ξεπεραστεί ο αριθμός -- κρατάμε τα πρώτα, με μήνυμα.
    private static (IReadOnlyList<IBrowserFile> Files, string? Error) PickFiles(InputFileChangeEventArgs e) =>
        e.FileCount > MaxFilesAtOnce
            ? (e.GetMultipleFiles(e.FileCount).Take(MaxFilesAtOnce).ToList(),
               $"Διάλεξες {e.FileCount} αρχεία -- κρατήθηκαν τα πρώτα {MaxFilesAtOnce}.")
            : (e.GetMultipleFiles(MaxFilesAtOnce), null);

    private async Task OnNewFilesSelected(InputFileChangeEventArgs e)
    {
        preparingFiles = true;
        var (files, pickError) = PickFiles(e);
        var errors = new List<string>();
        if (pickError != null) errors.Add(pickError);

        foreach (var file in files)
        {
            var (prepared, error) = await PrepareFileAsync(file);
            if (prepared != null) pendingFiles.Add(prepared);
            if (error != null) errors.Add(error);
        }

        fileMessage = string.Join(" ", errors);
        preparingFiles = false;
    }

    // ---- Λεπτομέρειες / Συνομιλία / Συνημμένα ----
    // Τα στοιχεία (προθεσμία, ανάθεση κλπ.) ξεκινούν κρυμμένα -- προτεραιότητα
    // στο κείμενο και τη συνομιλία· ανοίγουν με το κουμπί «Λεπτομέρειες».
    private bool showTaskDetails = false;

    private async Task OpenDetails(long id)
    {
        showTaskDetails = false;
        details = await Service.GetIssue(id, userManager.User?.IdUser);

        // "Το είδα" ανά χρήστη: δεν επηρεάζει τους υπόλοιπους.
        var userId = userManager.User?.IdUser;
        if (userId.HasValue)
        {
            await Service.MarkRead(id, userId.Value);
            var row = issues.FirstOrDefault(i => i.IssueID == id);
            if (row != null) row.IsUnread = false;
            await notifications.RequestRefresh();   // σβήνει αμέσως το καμπανάκι
        }
        newComment = "";
    }

    private void CloseDetails()
    {
        details = null;
        newComment = "";
    }

    // Γρήγορη αλλαγή στάτους από την κορυφή του παραθύρου — αποθηκεύεται αμέσως
    // και γράφεται στη συνομιλία ώστε να φαίνεται ποιος την έκανε και πότε.
    private async Task ChangeStatus(string? newStatus)
    {
        if (details == null || string.IsNullOrEmpty(newStatus) || newStatus == details.Issue.Status) return;
        var iss = details.Issue;
        detailsMessage = "";
        busy = true;
        var saved = await Service.SaveIssue(new SaveIssueRequest
        {
            IssueID = iss.IssueID,
            Title = iss.Title,
            Description = iss.Description,
            RegardingUserID = iss.RegardingUserID,
            RegardingName = iss.RegardingName,
            AssignedUserID = iss.AssignedUserID,
            AssignedName = iss.AssignedName,
            // Χωρίς αυτά, η αλλαγή στάτους έσβηνε την ανάθεση σε όλους/ομάδα
            AssignedToAll = iss.AssignedToAll,
            AssignedTeam = iss.AssignedTeam,
            Status = newStatus,
            Priority = iss.Priority,
            DueDate = iss.DueDate,
            ActingUserID = userManager.User?.IdUser,
            ActingUserName = UserFullName()
        });
        // Χωρίς αυτόν τον έλεγχο, μια αποτυχία άφηνε πίσω σχόλιο για αλλαγή
        // που δεν έγινε ποτέ.
        if (saved == null || !saved.Success)
        {
            detailsMessage = saved?.Message ?? "Η αλλαγή στάτους απέτυχε.";
            busy = false;
            return;
        }

        await Service.AddComment(new AddIssueCommentRequest
        {
            IssueID = iss.IssueID,
            UserID = userManager.User?.IdUser,
            UserName = UserFullName(),
            CommentText = $"⏩ Άλλαξε το στάτους σε «{StatusLabel(newStatus)}»"
        });
        details = await Service.GetIssue(iss.IssueID, userManager.User?.IdUser);
        busy = false;
        await Load();
    }

    private async Task SendComment()
    {
        if (details == null || string.IsNullOrWhiteSpace(newComment)) return;
        busy = true;
        await Service.AddComment(new AddIssueCommentRequest
        {
            IssueID = details.Issue.IssueID,
            UserID = userManager.User?.IdUser,
            UserName = UserFullName(),
            CommentText = newComment.Trim()
        });
        newComment = "";
        details = await Service.GetIssue(details.Issue.IssueID, userManager.User?.IdUser);
        busy = false;
        await Load();
    }

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        if (details == null || e.FileCount == 0) return;
        busy = true;
        detailsMessage = "";
        var issueId = details.Issue.IssueID;
        var (files, pickError) = PickFiles(e);
        var errors = new List<string>();
        if (pickError != null) errors.Add(pickError);
        var ok = 0;

        // Ένα-ένα: αν αποτύχει ένα, τα υπόλοιπα ανεβαίνουν κανονικά.
        foreach (var file in files)
        {
            var (prepared, error) = await PrepareFileAsync(file);
            if (prepared == null)
            {
                errors.Add(error ?? $"Δεν διαβάστηκε το «{file.Name}».");
                continue;
            }
            // Χωρίς έλεγχο, ένα αποτυχημένο ανέβασμα έδειχνε επιτυχημένο.
            var uploaded = await Service.UploadAttachment(issueId, prepared.Bytes, prepared.Name,
                userManager.User?.IdUser, UserFullName());
            if (uploaded) ok++;
            else errors.Add($"Το «{file.Name}» ({MegaBytes(prepared.Bytes.Length)} MB) δεν ανέβηκε -- δοκίμασε ξανά.");
        }

        if (errors.Any())
            detailsMessage = (files.Count > 1 ? $"Ανέβηκαν {ok} από {files.Count}. " : "") + string.Join(" ", errors);
        details = await Service.GetIssue(issueId, userManager.User?.IdUser);
        busy = false;
        await Load();
    }

    // Προεπισκόπηση: εικόνες και PDF ανοίγουν σε παράθυρο μέσα στη σελίδα·
    // ό,τι δεν προβάλλεται (π.χ. Excel) κατεβαίνει κατευθείαν.
    private IssueAttachmentDto? previewAtt;
    private string? previewUrl;
    private bool previewIsImage;

    private static string GuessContentType(IssueAttachmentDto att)
    {
        if (!string.IsNullOrEmpty(att.ContentType) && att.ContentType != "application/octet-stream")
            return att.ContentType;
        var ext = Path.GetExtension(att.FileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private async Task ViewAttachment(IssueAttachmentDto att)
    {
        var contentType = GuessContentType(att);
        var isImage = contentType.StartsWith("image/");
        var isPdf = contentType == "application/pdf";
        if (!isImage && !isPdf)
        {
            await DownloadAttachment(att);
            return;
        }

        previewAtt = att;
        previewUrl = null;
        previewIsImage = isImage;
        StateHasChanged();

        var bytes = await Service.DownloadAttachment(att.AttachmentID);
        if (bytes == null || bytes.Length == 0)
        {
            previewAtt = null;
            detailsMessage = "Το αρχείο δεν κατέβηκε. Δοκίμασε ξανά ή κατέβασέ το με το ⬇.";
            return;
        }
        previewUrl = await JS.InvokeAsync<string>("createObjectUrlFromBytes", contentType, bytes);
    }

    private async Task ClosePreview()
    {
        if (previewUrl != null)
            await JS.InvokeVoidAsync("revokeObjectUrl", previewUrl);
        previewAtt = null;
        previewUrl = null;
    }

    // Σε κινητά το <iframe> με blob URL συχνά μένει λευκό για PDF. Η νέα καρτέλα
    // τα δίνει στον εγγενή προβολέα του τηλεφώνου.
    private async Task OpenInNewTab(IssueAttachmentDto att)
    {
        var bytes = await Service.DownloadAttachment(att.AttachmentID);
        if (bytes == null || bytes.Length == 0)
        {
            detailsMessage = "Το αρχείο δεν κατέβηκε. Δοκίμασε ξανά.";
            return;
        }
        await JS.InvokeVoidAsync("openFileFromBytes",
            att.FileName ?? "attachment", GuessContentType(att), bytes);
    }

    private async Task DownloadAttachment(IssueAttachmentDto att)
    {
        var bytes = await Service.DownloadAttachment(att.AttachmentID);
        if (bytes != null && bytes.Length > 0)
            await JS.InvokeVoidAsync("downloadFileFromBytes", att.FileName ?? "attachment", bytes);
    }

    private async Task DeleteComment(IssueCommentDto c)
    {
        if (details == null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", "Διαγραφή αυτού του σχολίου;");
        if (!ok) return;
        var result = await Service.DeleteComment(new DeleteIssueCommentRequest
        {
            CommentID = c.CommentID,
            UserID = userManager.User?.IdUser
        });
        if (result != null && !result.Success && !string.IsNullOrEmpty(result.Message))
        {
            await JS.InvokeVoidAsync("alert", result.Message);
            return;
        }
        details = await Service.GetIssue(details.Issue.IssueID, userManager.User?.IdUser);
        await Load();
    }

    private async Task DeleteAttachment(IssueAttachmentDto att)
    {
        if (details == null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"Διαγραφή του συνημμένου «{att.FileName}»;");
        if (!ok) return;
        await Service.DeleteAttachment(att.AttachmentID);
        details = await Service.GetIssue(details.Issue.IssueID, userManager.User?.IdUser);
        await Load();
    }

    // ---- Helpers ----
    // Ονοματεπώνυμο του συνδεδεμένου χρήστη· αν λείπει, πέφτει στο username.
    private string UserFullName()
    {
        var name = $"{userManager.User?.Firstname} {userManager.User?.Lastname}".Trim();
        return string.IsNullOrEmpty(name) ? (userManager.User?.Username ?? "—") : name;
    }

    // Αρχικά χρήστη για το avatar της συνομιλίας (π.χ. "Γιάννης Γρηγοριάδης" -> ΓΓ).
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
        return initials.Length > 0 ? initials : "?";
    }

    private static string StatusLabel(string status) => status switch
    {
        "Open" => "Ανοιχτό",
        "InProgress" => "Σε εξέλιξη",
        "Done" => "Ολοκληρωμένο",
        "Cancelled" => "Ακυρωμένο",
        _ => status
    };

    private static string StatusBadge(string status) => status switch
    {
        "Open" => "bg-primary",
        "InProgress" => "bg-warning text-dark",
        "Done" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private static string PriorityLabel(string priority) => priority switch
    {
        "Low" => "Χαμηλή",
        "Normal" => "Κανονική",
        "High" => "🔴 Υψηλή",
        _ => priority
    };
}
