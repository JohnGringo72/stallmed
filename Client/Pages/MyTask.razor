    private async Task EnableNotifications()
    {
        // Η άδεια ζητιέται με κλικ του χρήστη -- οι browsers δεν τη δίνουν αλλιώς.
        // Πρώτα push (δουλεύει και με κλειστή την εφαρμογή)· αν δεν γίνεται,
        // οι απλές ειδοποιήσεις του browser όσο η σελίδα είναι ανοιχτή.
        // Αν λείπει η βοηθητική JS (π.χ. ο browser κρατά παλιό index.html από cache),
        // δεν σκάει η σελίδα: απλώς δεν ενεργοποιούνται οι ειδοποιήσεις.
        try
        {
