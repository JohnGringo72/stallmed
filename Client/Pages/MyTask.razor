@page "/mytasks"
@using Microsoft.AspNetCore.Components.Forms
@using StallmedManager.Shared.Models
@inject DataService dataService
@inject UserManager userManager
@inject IJSRuntime JS

<PageTitle>Tasks / Issues</PageTitle>

<style>
    .issue-row { cursor: pointer; }
    th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
    th.sortable:hover { background: #f1f3f5; }
    .chat-box {
        max-height: 320px;
        overflow-y: auto;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 12px;
    }
    .chat-msg { display: flex; gap: 8px; margin-bottom: 10px; align-items: flex-start; }
    .chat-msg.mine { flex-direction: row-reverse; }
    .chat-avatar {
        width: 34px; height: 34px; border-radius: 50%;
        background: #6c757d; color: white; font-weight: 700; font-size: 0.8rem;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .chat-msg.mine .chat-avatar { background: #0d6efd; }
    .chat-bubble {
        background: white; border: 1px solid #dee2e6; border-radius: 10px;
        padding: 6px 10px; max-width: 75%;
    }
    .chat-msg.mine .chat-bubble { background: #e7f1ff; border-color: #b6d4fe; }
    .chat-meta { font-size: 0.72rem; color: #6c757d; margin-bottom: 2px; }
    .chat-text { white-space: pre-wrap; word-break: break-word; }
</style>

<div class="sbt-page-header">
    <img src="images/icons/icon-mytask.svg" alt="" class="sbt-page-icon" />
    <h3 class="mb-3">Tasks / Issues</h3>
</div>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-12 col-md-4">
        <input class="form-control" placeholder="Αναζήτηση τίτλου, κωδικού, ονόματος..."
               value="@searchText" @oninput="e => searchText = e.Value?.ToString() ?? string.Empty" @onkeyup="OnSearchKeyUp" />
    </div>
    <div class="col-auto">
        <select class="form-select" value="@filterStatus" @onchange="OnFilterStatusChanged">
            <option value="">Όλα τα στάτους</option>
            <option value="Open">Ανοιχτά</option>
            <option value="InProgress">Σε εξέλιξη</option>
            <option value="Done">Ολοκληρωμένα</option>
            <option value="Cancelled">Ακυρωμένα</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" @onclick="Load" title="@Hint("Ανανέωση της λίστας")">🔄</button>
    </div>
    <div class="col-auto ms-auto">
        <button class="btn btn-primary" @onclick="OpenNew" title="@Hint("Δημιουργία νέου θέματος/εργασίας")">+ Νέο Θέμα</button>
    </div>
</div>

@if (loading)
{
    <p><em>Φορτώνω...</em></p>
}
else if (issues.Count == 0)
{
    <div class="alert alert-light border">Δεν υπάρχουν θέματα.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => SortBy("code")'>Κωδικός<span>@SortArrow("code")</span></th>
                    <th class="sortable" @onclick='() => SortBy("title")'>Τίτλος<span>@SortArrow("title")</span></th>
                    <th class="sortable d-none d-md-table-cell" @onclick='() => SortBy("regarding")'>Αφορά<span>@SortArrow("regarding")</span></th>
                    <th class="sortable d-none d-lg-table-cell" @onclick='() => SortBy("createdby")'>Άνοιξε<span>@SortArrow("createdby")</span></th>
                    <th class="sortable d-none d-lg-table-cell" @onclick='() => SortBy("created")'>Ημερομηνία<span>@SortArrow("created")</span></th>
                    <th class="sortable d-none d-md-table-cell" @onclick='() => SortBy("due")'>Προθεσμία<span>@SortArrow("due")</span></th>
                    <th class="sortable" @onclick='() => SortBy("status")'>Στάτους<span>@SortArrow("status")</span></th>
                    <th class="sortable d-none d-lg-table-cell" @onclick='() => SortBy("priority")'>Προτ/τητα<span>@SortArrow("priority")</span></th>
                    <th class="d-none d-lg-table-cell" title="Σχόλια / Συνημμένα">💬 / 📎</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in SortedIssues)
                {
                    <tr class="issue-row" @onclick="() => OpenDetails(i.IssueID)">
                        <td><strong>@i.IssueCode</strong></td>
                        <td>@i.Title</td>
                        <td class="d-none d-md-table-cell">@(string.IsNullOrEmpty(i.RegardingName) ? "—" : i.RegardingName)</td>
                        <td class="d-none d-lg-table-cell">@(string.IsNullOrEmpty(i.CreatedByName) ? "—" : i.CreatedByName)</td>
                        <td class="d-none d-lg-table-cell">@i.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="d-none d-md-table-cell">@(i.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td><span class="badge @StatusBadge(i.Status)">@StatusLabel(i.Status)</span></td>
                        <td class="d-none d-lg-table-cell">@PriorityLabel(i.Priority)</td>
                        <td class="d-none d-lg-table-cell text-muted small">@i.CommentCount / @i.AttachmentCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ===== Modal: Νέο / Επεξεργασία ===== *@
@if (showEdit)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">@(editId == null ? "Νέο Θέμα" : $"Επεξεργασία {editCode}")</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (editId == null)
                    {
                        <div class="mb-2 text-muted small">
                            Άνοιξε: <strong>@UserFullName()</strong> · @DateTime.Today.ToString("dd/MM/yyyy")
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label mb-1">Τίτλος *</label>
                        <input class="form-control" @bind="editTitle" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-1">Περιγραφή</label>
                        <textarea class="form-control" rows="3" @bind="editDescription"></textarea>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label mb-1">Αφορά (υπάλληλο / γιατρό)</label>
                            <select class="form-select" @bind="editRegardingKey">
                                <option value="">— επιλογή —</option>
                                <optgroup label="Πωλητές / Υπάλληλοι">
                                    @foreach (var u in users)
                                    {
                                        <option value="@($"u:{u.IdUser}")">@u.FullName@(string.IsNullOrEmpty(u.Role) ? "" : $" ({u.Role})")</option>
                                    }
                                </optgroup>
                                <optgroup label="Γιατροί">
                                    @foreach (var d in doctors)
                                    {
                                        <option value="@($"d:{d.DoctorID}")">@d.FullName</option>
                                    }
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-1">Ανάθεση σε</label>
                            <select class="form-select" @bind="editAssignedUserId">
                                <option value="">— κανείς —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.IdUser">@u.FullName@(string.IsNullOrEmpty(u.Role) ? "" : $" ({u.Role})")</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label mb-1">Προτεραιότητα</label>
                            <select class="form-select" @bind="editPriority">
                                <option value="Low">Χαμηλή</option>
                                <option value="Normal">Κανονική</option>
                                <option value="High">Υψηλή</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1">Προθεσμία</label>
                            <InputDate @bind-Value="editDueDate" class="form-control" />
                        </div>
                        @if (editId != null)
                        {
                            <div class="col-md-4">
                                <label class="form-label mb-1">Στάτους</label>
                                <select class="form-select" @bind="editStatus">
                                    <option value="Open">Ανοιχτό</option>
                                    <option value="InProgress">Σε εξέλιξη</option>
                                    <option value="Done">Ολοκληρωμένο</option>
                                    <option value="Cancelled">Ακυρωμένο</option>
                                </select>
                            </div>
                        }
                    </div>
                    @if (editId == null)
                    {
                        <hr class="my-2" />
                        <div class="mb-2">
                            <label class="form-label mb-1">📎 Αρχεία (π.χ. συνταγή — προαιρετικά, μπορείς πολλά μαζί)</label>
                            <InputFile OnChange="OnNewFilesSelected" multiple class="form-control form-control-sm" />
                            @if (pendingFiles.Any())
                            {
                                <ul class="list-group mt-1">
                                    @foreach (var f in pendingFiles)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                            <span class="small">@f.Name <span class="text-muted">(@((f.Bytes.Length / 1024.0).ToString("N0")) KB)</span></span>
                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => pendingFiles.Remove(f)">×</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label mb-1">💬 Πρώτο σχόλιο (προαιρετικά)</label>
                            <textarea class="form-control" rows="2" @bind="firstComment" placeholder="π.χ. «Κάνε αυτό μέχρι Παρασκευή»"></textarea>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(editMessage))
                    {
                        <div class="alert alert-warning py-2 mb-0">@editMessage</div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary" @onclick="CloseEdit">Ακύρωση</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@busy">@(editId == null ? "Δημιουργία" : "Αποθήκευση")</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal: Λεπτομέρειες + Συνομιλία + Συνημμένα ===== *@
@if (details != null)
{
    var iss = details.Issue;
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseDetails">
        <div class="modal-dialog modal-xl modal-fullscreen-lg-down" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title d-flex align-items-center gap-2 flex-wrap">
                        @iss.IssueCode — @iss.Title
                        <select class="form-select form-select-sm w-auto @StatusBadge(iss.Status)" style="font-weight:600"
                                value="@iss.Status" @onchange="e => ChangeStatus(e.Value?.ToString())"
                                title="@Hint("Αλλαγή στάτους — αποθηκεύεται αμέσως")">
                            <option value="Open">Ανοιχτό</option>
                            <option value="InProgress">Σε εξέλιξη</option>
                            <option value="Done">Ολοκληρωμένο</option>
                            <option value="Cancelled">Ακυρωμένο</option>
                        </select>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-lg-5">
                            <table class="table table-sm mb-2">
                                <tbody>
                                    <tr><th style="width:130px">Αφορά</th><td>@(string.IsNullOrEmpty(iss.RegardingName) ? "—" : iss.RegardingName)</td></tr>
                                    <tr><th>Άνοιξε</th><td>@(string.IsNullOrEmpty(iss.CreatedByName) ? "—" : iss.CreatedByName) · @iss.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                                    <tr><th>Ανάθεση</th><td>@(string.IsNullOrEmpty(iss.AssignedName) ? "—" : iss.AssignedName)</td></tr>
                                    <tr><th>Προθεσμία</th><td>@(iss.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                    <tr><th>Προτεραιότητα</th><td>@PriorityLabel(iss.Priority)</td></tr>
                                    <tr><th>Τελ. ενημέρωση</th><td>@iss.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                                </tbody>
                            </table>
                            @if (!string.IsNullOrWhiteSpace(iss.Description))
                            {
                                <div class="border rounded p-2 mb-2" style="white-space:pre-wrap">@iss.Description</div>
                            }
                            <button class="btn btn-sm btn-outline-primary mb-3" @onclick="() => OpenEditFromDetails()">✏️ Επεξεργασία / Αλλαγή στάτους</button>

                            <h6>📎 Συνημμένα (@details.Attachments.Count)</h6>
                            @if (details.Attachments.Any())
                            {
                                <ul class="list-group mb-2">
                                    @foreach (var att in details.Attachments)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                            <a href="javascript:void(0)" @onclick="() => ViewAttachment(att)" title="@Hint("Άνοιγμα σε νέα καρτέλα (εικόνες/PDF εμφανίζονται απευθείας)")">@att.FileName</a>
                                            <span class="d-flex align-items-center gap-1">
                                                <span class="text-muted small">@att.UploadedByName @att.CreatedAt.ToString("dd/MM")</span>
                                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => DownloadAttachment(att)" title="@Hint("Κατέβασμα του αρχείου")">⬇</button>
                                                <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteAttachment(att)" title="@Hint("Διαγραφή συνημμένου")">×</button>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                            <InputFile OnChange="OnAttachmentSelected" class="form-control form-control-sm" />
                            @if (busy)
                            {
                                <em class="small text-muted">Επεξεργάζομαι...</em>
                            }
                        </div>
                        <div class="col-lg-7">
                            <h6>💬 Συνομιλία (@details.Comments.Count)</h6>
                            <div class="chat-box mb-2" id="issueChatBox">
                                @if (!details.Comments.Any())
                                {
                                    <p class="text-muted mb-0"><em>Κανένα σχόλιο ακόμα.</em></p>
                                }
                                @foreach (var c in details.Comments)
                                {
                                    var mine = c.UserID != null && c.UserID == userManager.User?.IdUser;
                                    <div class="chat-msg @(mine ? "mine" : "")">
                                        <div class="chat-avatar" title="@c.UserName">@Initials(c.UserName)</div>
                                        <div class="chat-bubble">
                                            <div class="chat-meta">@c.UserName · @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            <div class="chat-text">@c.CommentText</div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <textarea class="form-control" rows="2" placeholder="Γράψε σχόλιο... (π.χ. «Κάνε αυτό», «Το έκανα, θέλω 2»)"
                                          @bind="newComment" @bind:event="oninput"></textarea>
                                <button class="btn btn-primary" @onclick="SendComment" disabled="@(busy || string.IsNullOrWhiteSpace(newComment))">Αποστολή</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal: Προεπισκόπηση αρχείου (εικόνες/PDF) ===== *@
@if (previewAtt != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index:1070;" @onclick="ClosePreview">
        <div class="modal-dialog modal-xl modal-fullscreen-lg-down" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">📄 @previewAtt.FileName</h6>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body p-1 text-center" style="background:#40444b">
                    @if (previewUrl == null)
                    {
                        <p class="text-white p-3 mb-0"><em>Φορτώνω...</em></p>
                    }
                    else if (previewIsImage)
                    {
                        <img src="@previewUrl" style="max-width:100%; max-height:75vh" />
                    }
                    else
                    {
                        <iframe src="@previewUrl" style="width:100%; height:75vh; border:0; background:white"></iframe>
                    }
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAttachment(previewAtt)">⬇ Κατέβασμα</button>
                    <button class="btn btn-sm btn-secondary" @onclick="ClosePreview">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public UiPreferencesService? UiPrefs { get; set; }
    private string? Hint(string text) => (UiPrefs?.ShowHints ?? true) ? text : null;

    private IssuesService Service => new IssuesService(dataService);

    private List<IssueListItemDto> issues = new();

    // Ταξινόμηση λίστας με κλικ στις επικεφαλίδες (δεύτερο κλικ = αντίστροφη σειρά).
    private string sortField = "code";
    private bool sortAsc = false;   // προεπιλογή: νεότερα πρώτα

    private void SortBy(string field)
    {
        if (sortField == field) sortAsc = !sortAsc;
        else { sortField = field; sortAsc = true; }
    }

    private string SortArrow(string field)
        => sortField == field ? (sortAsc ? " ▲" : " ▼") : "";

    private static int PriorityRank(string p) => p switch { "High" => 2, "Normal" => 1, "Low" => 0, _ => -1 };
    private static int StatusRank(string s) => s switch { "Open" => 0, "InProgress" => 1, "Done" => 2, "Cancelled" => 3, _ => 4 };

    private IEnumerable<IssueListItemDto> SortedIssues
    {
        get
        {
            IOrderedEnumerable<IssueListItemDto> sorted = sortField switch
            {
                "title" => issues.OrderBy(i => i.Title, StringComparer.CurrentCultureIgnoreCase),
                "regarding" => issues.OrderBy(i => i.RegardingName ?? "", StringComparer.CurrentCultureIgnoreCase),
                "createdby" => issues.OrderBy(i => i.CreatedByName ?? "", StringComparer.CurrentCultureIgnoreCase),
                "created" => issues.OrderBy(i => i.CreatedAt),
                "due" => issues.OrderBy(i => i.DueDate == null).ThenBy(i => i.DueDate), // χωρίς προθεσμία στο τέλος
                "status" => issues.OrderBy(i => StatusRank(i.Status)),
                "priority" => issues.OrderBy(i => PriorityRank(i.Priority)),
                _ => issues.OrderBy(i => i.IssueID)
            };
            return sortAsc ? sorted : sorted.Reverse();
        }
    }
    private List<IssueUserDto> users = new();
    private List<DoctorOptionDto> doctors = new();
    private bool loading = true;
    private bool busy = false;
    private string searchText = "";
    private string filterStatus = "";

    // Νέο/Επεξεργασία
    private bool showEdit = false;
    private long? editId;
    private string editCode = "";
    private string editTitle = "";
    private string? editDescription;
    // «Αφορά»: μία τιμή για δύο πηγές — "u:<IdUser>" για χρήστη, "d:<DoctorID>"
    // για γιατρό. Ο γιατρός αποθηκεύεται μόνο ως όνομα (RegardingName snapshot,
    // RegardingUserID = null), όπως προβλέπει το σχήμα του issues_module.sql.
    private string editRegardingKey = "";
    private int? editAssignedUserId;
    private string editPriority = "Normal";
    private string editStatus = "Open";
    private DateTime? editDueDate;
    private string editMessage = "";

    // Λεπτομέρειες
    private IssueDetailsDto? details;
    private string newComment = "";

    // Αρχεία + πρώτο σχόλιο που επιλέχθηκαν στη φόρμα ΠΡΙΝ την αποθήκευση:
    // ανεβαίνουν αμέσως μετά τη δημιουργία του θέματος.
    private record PendingFile(string Name, byte[] Bytes);
    private List<PendingFile> pendingFiles = new();
    private string firstComment = "";

    protected override async Task OnInitializedAsync()
    {
        users = await Service.GetUsers();
        doctors = await Service.GetDoctors();
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        issues = await Service.GetIssues(string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                                         string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim());
        loading = false;
    }

    private async Task OnFilterStatusChanged(ChangeEventArgs e)
    {
        filterStatus = e.Value?.ToString() ?? "";
        await Load();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    // ---- Νέο / Επεξεργασία ----
    private void OpenNew()
    {
        editId = null;
        editCode = "";
        editTitle = "";
        editDescription = null;
        // Προεπιλογή: το θέμα αφορά αυτόν που το γράφει (αλλάζεται ελεύθερα).
        editRegardingKey = userManager.User?.IdUser is int uid ? $"u:{uid}" : "";
        editAssignedUserId = null;
        editPriority = "Normal";
        editStatus = "Open";
        editDueDate = DateTime.Today.AddDays(7);   // προεπιλογή: 1 εβδομάδα
        editMessage = "";
        pendingFiles.Clear();
        firstComment = "";
        showEdit = true;
    }

    private void OpenEditFromDetails()
    {
        if (details == null) return;
        var iss = details.Issue;
        editId = iss.IssueID;
        editCode = iss.IssueCode;
        editTitle = iss.Title;
        editDescription = iss.Description;
        if (iss.RegardingUserID != null)
        {
            editRegardingKey = $"u:{iss.RegardingUserID}";
        }
        else
        {
            // Γιατρός: κρατιέται μόνο το όνομα, οπότε το ξαναβρίσκουμε στη λίστα.
            var doc = doctors.FirstOrDefault(d => d.FullName == iss.RegardingName);
            editRegardingKey = doc != null ? $"d:{doc.DoctorID}" : "";
        }
        editAssignedUserId = iss.AssignedUserID;
        editPriority = iss.Priority;
        editStatus = iss.Status;
        editDueDate = iss.DueDate;
        editMessage = "";
        showEdit = true;
    }

    private (int? userId, string? name) ResolveRegarding()
    {
        if (editRegardingKey.StartsWith("u:") && int.TryParse(editRegardingKey[2..], out var uid))
            return (uid, users.FirstOrDefault(u => u.IdUser == uid)?.FullName);
        if (editRegardingKey.StartsWith("d:") && int.TryParse(editRegardingKey[2..], out var did))
            return (null, doctors.FirstOrDefault(d => d.DoctorID == did)?.FullName);
        return (null, null);
    }

    private void CloseEdit()
    {
        showEdit = false;
        editMessage = "";
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(editTitle))
        {
            editMessage = "Ο τίτλος είναι υποχρεωτικός.";
            return;
        }
        busy = true;
        var (regUserId, regName) = ResolveRegarding();
        var result = await Service.SaveIssue(new SaveIssueRequest
        {
            IssueID = editId,
            Title = editTitle,
            Description = editDescription,
            RegardingUserID = regUserId,
            RegardingName = regName,
            AssignedUserID = editAssignedUserId,
            AssignedName = users.FirstOrDefault(u => u.IdUser == editAssignedUserId)?.FullName,
            Status = editStatus,
            Priority = editPriority,
            DueDate = editDueDate,
            ActingUserID = userManager.User?.IdUser,
            ActingUserName = UserFullName()
        });
        busy = false;
        if (result == null || !result.Success)
        {
            editMessage = result?.Message ?? "Η αποθήκευση απέτυχε.";
            return;
        }

        // Νέο θέμα: ανέβασμα των αρχείων και του πρώτου σχολίου που γράφτηκαν στη φόρμα.
        if (editId == null)
        {
            busy = true;
            foreach (var f in pendingFiles)
                await Service.UploadAttachment(result.IssueID, f.Bytes, f.Name,
                    userManager.User?.IdUser, UserFullName());
            if (!string.IsNullOrWhiteSpace(firstComment))
                await Service.AddComment(new AddIssueCommentRequest
                {
                    IssueID = result.IssueID,
                    UserID = userManager.User?.IdUser,
                    UserName = UserFullName(),
                    CommentText = firstComment.Trim()
                });
            pendingFiles.Clear();
            firstComment = "";
            busy = false;
        }

        showEdit = false;
        await Load();
        // Αν η επεξεργασία έγινε από τα details, φρεσκάρισμα του ανοιχτού παραθύρου·
        // αλλιώς άνοιγμα του νέου θέματος για άμεσο έλεγχο.
        if (details != null && editId != null)
            details = await Service.GetIssue(editId.Value);
        else if (editId == null)
            details = await Service.GetIssue(result.IssueID);
    }

    private async Task OnNewFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
            pendingFiles.Add(new PendingFile(file.Name, ms.ToArray()));
        }
    }

    // ---- Λεπτομέρειες / Συνομιλία / Συνημμένα ----
    private async Task OpenDetails(long id)
    {
        details = await Service.GetIssue(id);
        newComment = "";
    }

    private void CloseDetails()
    {
        details = null;
        newComment = "";
    }

    // Γρήγορη αλλαγή στάτους από την κορυφή του παραθύρου — αποθηκεύεται αμέσως
    // και γράφεται στη συνομιλία ώστε να φαίνεται ποιος την έκανε και πότε.
    private async Task ChangeStatus(string? newStatus)
    {
        if (details == null || string.IsNullOrEmpty(newStatus) || newStatus == details.Issue.Status) return;
        var iss = details.Issue;
        busy = true;
        await Service.SaveIssue(new SaveIssueRequest
        {
            IssueID = iss.IssueID,
            Title = iss.Title,
            Description = iss.Description,
            RegardingUserID = iss.RegardingUserID,
            RegardingName = iss.RegardingName,
            AssignedUserID = iss.AssignedUserID,
            AssignedName = iss.AssignedName,
            Status = newStatus,
            Priority = iss.Priority,
            DueDate = iss.DueDate,
            ActingUserID = userManager.User?.IdUser,
            ActingUserName = UserFullName()
        });
        await Service.AddComment(new AddIssueCommentRequest
        {
            IssueID = iss.IssueID,
            UserID = userManager.User?.IdUser,
            UserName = UserFullName(),
            CommentText = $"⏩ Άλλαξε το στάτους σε «{StatusLabel(newStatus)}»"
        });
        details = await Service.GetIssue(iss.IssueID);
        busy = false;
        await Load();
    }

    private async Task SendComment()
    {
        if (details == null || string.IsNullOrWhiteSpace(newComment)) return;
        busy = true;
        await Service.AddComment(new AddIssueCommentRequest
        {
            IssueID = details.Issue.IssueID,
            UserID = userManager.User?.IdUser,
            UserName = UserFullName(),
            CommentText = newComment.Trim()
        });
        newComment = "";
        details = await Service.GetIssue(details.Issue.IssueID);
        busy = false;
        await Load();
    }

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        if (details == null || e.File == null) return;
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
        busy = true;
        await Service.UploadAttachment(details.Issue.IssueID, ms.ToArray(), e.File.Name,
            userManager.User?.IdUser, UserFullName());
        details = await Service.GetIssue(details.Issue.IssueID);
        busy = false;
        await Load();
    }

    // Προεπισκόπηση: εικόνες και PDF ανοίγουν σε παράθυρο μέσα στη σελίδα·
    // ό,τι δεν προβάλλεται (π.χ. Excel) κατεβαίνει κατευθείαν.
    private IssueAttachmentDto? previewAtt;
    private string? previewUrl;
    private bool previewIsImage;

    private static string GuessContentType(IssueAttachmentDto att)
    {
        if (!string.IsNullOrEmpty(att.ContentType) && att.ContentType != "application/octet-stream")
            return att.ContentType;
        var ext = Path.GetExtension(att.FileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private async Task ViewAttachment(IssueAttachmentDto att)
    {
        var contentType = GuessContentType(att);
        var isImage = contentType.StartsWith("image/");
        var isPdf = contentType == "application/pdf";
        if (!isImage && !isPdf)
        {
            await DownloadAttachment(att);
            return;
        }

        previewAtt = att;
        previewUrl = null;
        previewIsImage = isImage;
        StateHasChanged();

        var bytes = await Service.DownloadAttachment(att.AttachmentID);
        if (bytes == null || bytes.Length == 0)
        {
            previewAtt = null;
            return;
        }
        previewUrl = await JS.InvokeAsync<string>("createObjectUrlFromBytes", contentType, bytes);
    }

    private async Task ClosePreview()
    {
        if (previewUrl != null)
            await JS.InvokeVoidAsync("revokeObjectUrl", previewUrl);
        previewAtt = null;
        previewUrl = null;
    }

    private async Task DownloadAttachment(IssueAttachmentDto att)
    {
        var bytes = await Service.DownloadAttachment(att.AttachmentID);
        if (bytes != null && bytes.Length > 0)
            await JS.InvokeVoidAsync("downloadFileFromBytes", att.FileName ?? "attachment", bytes);
    }

    private async Task DeleteAttachment(IssueAttachmentDto att)
    {
        if (details == null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"Διαγραφή του συνημμένου «{att.FileName}»;");
        if (!ok) return;
        await Service.DeleteAttachment(att.AttachmentID);
        details = await Service.GetIssue(details.Issue.IssueID);
        await Load();
    }

    // ---- Helpers ----
    // Ονοματεπώνυμο του συνδεδεμένου χρήστη· αν λείπει, πέφτει στο username.
    private string UserFullName()
    {
        var name = $"{userManager.User?.Firstname} {userManager.User?.Lastname}".Trim();
        return string.IsNullOrEmpty(name) ? (userManager.User?.Username ?? "—") : name;
    }

    // Αρχικά χρήστη για το avatar της συνομιλίας (π.χ. "Γιάννης Γρηγοριάδης" -> ΓΓ).
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = string.Concat(parts.Take(2).Select(p => char.ToUpper(p[0])));
        return initials.Length > 0 ? initials : "?";
    }

    private static string StatusLabel(string status) => status switch
    {
        "Open" => "Ανοιχτό",
        "InProgress" => "Σε εξέλιξη",
        "Done" => "Ολοκληρωμένο",
        "Cancelled" => "Ακυρωμένο",
        _ => status
    };

    private static string StatusBadge(string status) => status switch
    {
        "Open" => "bg-primary",
        "InProgress" => "bg-warning text-dark",
        "Done" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private static string PriorityLabel(string priority) => priority switch
    {
        "Low" => "Χαμηλή",
        "Normal" => "Κανονική",
        "High" => "🔴 Υψηλή",
        _ => priority
    };
