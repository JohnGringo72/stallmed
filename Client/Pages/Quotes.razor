    // Επεξεργασία στοιχείων (ΑΦΜ, τμήμα, email...) του επιλεγμένου πελάτη --
    // ενημερώνει την υπάρχουσα εγγραφή στον πίνακα Doctors.
    private void OpenEditCustomer()
    {
        var selected = customers.FirstOrDefault(c => c.DoctorID == editCustomerId);
        if (selected == null) return;
        newCustomer = new CustomerDto
        {
            DoctorID = selected.DoctorID,
            Name = selected.Name,
            VatNumber = selected.VatNumber,
            Department = selected.Department,
            ContactPerson = selected.ContactPerson,
            Email = selected.Email,
            Phone = selected.Phone,
            Address = selected.Address,
            City = selected.City,
            PostalCode = selected.PostalCode
        };
        showCustomerModal = true;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomer.Name))
        {
            ShowMessage("Η επωνυμία είναι υποχρεωτική.", isError: true);
            return;
        }
        busy = true;
        var saved = newCustomer.DoctorID == 0
            ? await Service.CreateCustomer(newCustomer)
            : await Service.UpdateCustomer(newCustomer.DoctorID, newCustomer);
        busy = false;
        if (saved == null)
        {
            ShowMessage("Σφάλμα αποθήκευσης πελάτη.", isError: true);
            return;
        }
        customers = await Service.GetCustomers(null);
        editCustomerId = saved.DoctorID;
        newCustomer = new CustomerDto();
        showCustomerModal = false;
    }

    // ---- Εισαγωγή γραμμών από Excel ----

    private async Task DownloadImportTemplate()
    {
        var bytes = await Service.DownloadImportTemplate();
        if (bytes != null)
            await JS.InvokeVoidAsync("downloadFileFromBytes", "Πρότυπο_Εισαγωγής_Προσφοράς.xlsx", bytes);
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

        busy = true;
        var preview = await Service.ImportPreview(editCompany, ms.ToArray(), file.Name);
        busy = false;

        if (preview == null)
        {
            importSummary = "Σφάλμα ανάγνωσης του αρχείου.";
            importHadErrors = true;
            return;
        }

        var valid = preview.Lines.Where(l => l.IsValid).ToList();
        foreach (var l in valid)
        {
            editLines.Add(new SaveQuoteLineRequest
            {
                CodePrick = l.CodePrick,
                ProductTypeCode = l.ProductTypeCode,
                Description = l.Description,
                Quantity = l.Quantity,
                Unit = "τεμ.",
                UnitPrice = l.UnitPrice,
                DiscountPct = l.DiscountPct,
                VatRate = l.VatRate
            });
        }
        // Καθάρισμα τυχόν αρχικής κενής γραμμής
        editLines.RemoveAll(l => string.IsNullOrEmpty(l.CodePrick) && string.IsNullOrEmpty(l.ProductTypeCode));
        if (editLines.Count == 0) AddLine();

        importHadErrors = preview.ErrorRows > 0;
        importSummary = preview.ErrorRows == 0
            ? $"Εισήχθησαν {valid.Count} γραμμές."
            : $"Εισήχθησαν {valid.Count} γραμμές, {preview.ErrorRows} απορρίφθηκαν: " +
              string.Join(" · ", preview.Lines.Where(l => !l.IsValid).Take(3)
                  .Select(l => $"{l.CodePrick}/{l.ProductTypeCode}: {l.Warning}"));
    }
