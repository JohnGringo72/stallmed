@page "/quotes"
@using StallmedManager.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@inject DataService dataService
@inject UserManager userManager
@inject IJSRuntime JS

<PageTitle>Προσφορές</PageTitle>

<style>
    .filters-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .quote-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1050;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
        padding: 30px 10px;
    }

    .quote-modal {
        background: white;
        border-radius: 10px;
        width: 100%;
        max-width: 1000px;
        padding: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.3);
    }

    .quote-modal-sm {
        max-width: 550px;
    }

    .lines-table input, .lines-table select {
        font-size: 0.85rem;
    }

    .totals-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 10px 16px;
        display: inline-block;
        min-width: 260px;
    }
</style>

<div class="sbt-page-header">
    <h1 class="mb-3">Προσφορές</h1>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null"></button>
    </div>
}

<div class="filters-panel">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label mb-1">Εταιρεία</label>
            <select class="form-select" @bind="filterCompany">
                <option value="">Όλες</option>
                <option value="SM">SM</option>
                <option value="BM">BM</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label mb-1">Κατάσταση</label>
            <select class="form-select" @bind="filterStatus">
                <option value="All">Όλες</option>
                <option value="@QuoteStatus.Draft">@QuoteStatus.Label(QuoteStatus.Draft)</option>
                <option value="@QuoteStatus.Sent">@QuoteStatus.Label(QuoteStatus.Sent)</option>
                <option value="@QuoteStatus.Accepted">@QuoteStatus.Label(QuoteStatus.Accepted)</option>
                <option value="@QuoteStatus.Rejected">@QuoteStatus.Label(QuoteStatus.Rejected)</option>
                <option value="@QuoteStatus.Expired">@QuoteStatus.Label(QuoteStatus.Expired)</option>
                <option value="@QuoteStatus.Converted">@QuoteStatus.Label(QuoteStatus.Converted)</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label mb-1">Από</label>
            <input type="date" class="form-control" @bind="filterFrom" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label mb-1">Έως</label>
            <input type="date" class="form-control" @bind="filterTo" />
        </div>
        <div class="col-8 col-md-2">
            <label class="form-label mb-1">Αναζήτηση</label>
            <input class="form-control" placeholder="Αριθμός, πελάτης..." @bind="filterSearch"
                   @onkeyup="@(async e => { if (e.Key == "Enter") await LoadQuotes(); })" />
        </div>
        <div class="col-4 col-md-2 d-flex gap-2">
            <button class="btn btn-outline-primary w-50" @onclick="LoadQuotes">Φίλτρα</button>
            <button class="btn btn-success w-50" @onclick="OpenCreate">+ Νέα</button>
        </div>
    </div>
</div>

@if (loading)
{
    <p><em>Φορτώνω...</em></p>
}
else if (quotes.Count == 0)
{
    <div class="alert alert-info">Δεν βρέθηκαν προσφορές.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Αριθμός</th>
                    <th>Ημ/νία</th>
                    <th>Πελάτης</th>
                    <th>Εταιρεία</th>
                    <th>Ισχύς έως</th>
                    <th class="text-end">Σύνολο</th>
                    <th>Κατάσταση</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in quotes)
                {
                    <tr style="cursor:pointer" @onclick="() => OpenDetails(q)">
                        <td class="fw-bold">@q.QuoteNumber</td>
                        <td>@q.IssueDate.ToString("dd/MM/yyyy")</td>
                        <td>@q.CustomerName</td>
                        <td>
                            <span class="badge" style="background-color:@(q.Company == "SM" ? "#28a745" : "#b57bee")">@q.Company</span>
                        </td>
                        <td>@q.ValidUntil.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@q.Total.ToString("N2") €</td>
                        <td>
                            <span class="badge bg-@QuoteStatus.Color(q.Status)">@QuoteStatus.Label(q.Status)</span>
                            @if (q.AttachmentCount > 0)
                            {
                                <span class="badge bg-light text-dark ms-1" title="Συνημμένα">📎 @q.AttachmentCount</span>
                            }
                        </td>
                        <td>
                            @if (q.HasPdf)
                            {
                                <button class="btn btn-sm btn-outline-secondary" title="Λήψη PDF"
                                        @onclick:stopPropagation="true" @onclick="() => DownloadPdf(q)">PDF</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ============ Modal προβολής ============ *@
@if (detailsQuote != null)
{
    <div class="quote-modal-backdrop" @onclick="CloseDetails">
        <div class="quote-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h4 class="mb-1">
                        @detailsQuote.QuoteNumber
                        <span class="badge bg-@QuoteStatus.Color(detailsQuote.Status) ms-2">@QuoteStatus.Label(detailsQuote.Status)</span>
                        <span class="badge ms-1" style="background-color:@(detailsQuote.Company == "SM" ? "#28a745" : "#b57bee")">@detailsQuote.Company</span>
                    </h4>
                    <div class="text-muted small">
                        Έκδοση: @detailsQuote.IssueDate.ToString("dd/MM/yyyy") · Ισχύς έως: @detailsQuote.ValidUntil.ToString("dd/MM/yyyy")
                        @if (detailsQuote.SentAt.HasValue)
                        {
                            <span> · Εστάλη: @detailsQuote.SentAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </div>
                </div>
                <button class="btn-close" @onclick="CloseDetails"></button>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="fw-bold">@detailsQuote.CustomerName</div>
                    @if (!string.IsNullOrEmpty(detailsQuote.CustomerDepartment))
                    {
                        <div class="small">@detailsQuote.CustomerDepartment</div>
                    }
                    @if (!string.IsNullOrEmpty(detailsQuote.CustomerContact))
                    {
                        <div class="small">Υπόψη: @detailsQuote.CustomerContact</div>
                    }
                    <div class="small text-muted">
                        @detailsQuote.CustomerEmail @detailsQuote.CustomerPhone
                        @if (!string.IsNullOrEmpty(detailsQuote.CustomerVat))
                        {
                            <span> · ΑΦΜ: @detailsQuote.CustomerVat</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(detailsQuote.HospitalRequestRef))
                    {
                        <div class="small">Αρ. πρωτ. ζήτησης: <b>@detailsQuote.HospitalRequestRef</b></div>
                    }
                    @if (!string.IsNullOrEmpty(detailsQuote.Notes))
                    {
                        <div class="small text-muted">Σημειώσεις: @detailsQuote.Notes</div>
                    }
                    @if (detailsQuote.Status == QuoteStatus.Rejected && !string.IsNullOrEmpty(detailsQuote.RejectReason))
                    {
                        <div class="small text-danger">Λόγος απόρριψης: @detailsQuote.RejectReason</div>
                    }
                    @if (detailsQuote.Status == QuoteStatus.Converted)
                    {
                        <div class="small text-success">Παραγγελία: <b>@(detailsQuote.ConvertedOrderCode ?? detailsQuote.ConvertedOrderID?.ToString())</b></div>
                    }
                </div>
            </div>

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Κωδικός</th>
                        <th>Περιγραφή</th>
                        <th class="text-end">Ποσ.</th>
                        <th class="text-end">Τιμή μον.</th>
                        <th class="text-end">Έκπτ.</th>
                        <th class="text-end">ΦΠΑ</th>
                        <th class="text-end">Σύνολο</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (line, idx) in detailsQuote.Lines.Select((l, i) => (l, i)))
                    {
                        <tr>
                            <td>@(idx + 1)</td>
                            <td>@line.CodePrick / @line.ProductTypeCode</td>
                            <td>@(string.IsNullOrEmpty(line.Description) ? $"{line.AllergenDescription} - {line.ProductDescription}" : line.Description)</td>
                            <td class="text-end">@line.Quantity @line.Unit</td>
                            <td class="text-end">@line.UnitPrice.ToString("N2") €</td>
                            <td class="text-end">@(line.DiscountPct > 0 ? $"{line.DiscountPct:N1}%" : "-")</td>
                            <td class="text-end">@line.VatRate.ToString("N1")%</td>
                            <td class="text-end">@line.LineTotal.ToString("N2") €</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-end mb-3">
                <div class="totals-box">
                    <div class="d-flex justify-content-between"><span>Καθαρή αξία:</span><span>@detailsQuote.Subtotal.ToString("N2") €</span></div>
                    <div class="d-flex justify-content-between"><span>ΦΠΑ:</span><span>@detailsQuote.VatTotal.ToString("N2") €</span></div>
                    <div class="d-flex justify-content-between fw-bold"><span>Γενικό σύνολο:</span><span>@detailsQuote.Total.ToString("N2") €</span></div>
                </div>
            </div>

            <div class="mb-3">
                <h6 class="mb-2">Συνημμένα</h6>
                @if (attachments.Count == 0)
                {
                    <div class="text-muted small mb-2">Δεν υπάρχουν συνημμένα.</div>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var att in attachments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                <a href="javascript:void(0)" @onclick="() => DownloadAttachment(att)">@att.FileName</a>
                                <span>
                                    <span class="text-muted small me-2">@att.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttachment(att)">×</button>
                                </span>
                            </li>
                        }
                    </ul>
                }
                <InputFile OnChange="OnAttachmentSelected" class="form-control form-control-sm" style="max-width:320px;" />
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end">
                @if (busy)
                {
                    <span class="text-muted align-self-center"><em>Επεξεργάζομαι...</em></span>
                }
                <button class="btn btn-outline-secondary" @onclick="() => GeneratePdf(detailsQuote)" disabled="@busy">Έκδοση PDF</button>
                @if (QuoteStateMachine.CanEdit(detailsQuote.Status))
                {
                    <button class="btn btn-outline-primary" @onclick="() => OpenEdit(detailsQuote)" disabled="@busy">Επεξεργασία</button>
                }
                @if (detailsQuote.Status == QuoteStatus.Draft)
                {
                    <button class="btn btn-primary" @onclick="() => SendQuote(detailsQuote)" disabled="@busy">Αποστολή email</button>
                }
                @if (detailsQuote.Status == QuoteStatus.Sent)
                {
                    <button class="btn btn-success" @onclick="() => Accept(detailsQuote)" disabled="@busy">Αποδοχή</button>
                    <button class="btn btn-outline-danger" @onclick="() => rejectingQuote = detailsQuote" disabled="@busy">Απόρριψη</button>
                    <button class="btn btn-outline-warning" @onclick="() => ExpireQuote(detailsQuote)" disabled="@busy">Λήξη</button>
                }
                @if (detailsQuote.Status == QuoteStatus.Accepted)
                {
                    <button class="btn btn-success" @onclick="() => ConvertQuote(detailsQuote)" disabled="@busy">Μετατροπή σε παραγγελία</button>
                }
                @if (detailsQuote.Status == QuoteStatus.Expired)
                {
                    <button class="btn btn-warning" @onclick="() => Reissue(detailsQuote)" disabled="@busy">Επανέκδοση</button>
                }
            </div>
        </div>
    </div>
}

@* ============ Modal απόρριψης (λόγος) ============ *@
@if (rejectingQuote != null)
{
    <div class="quote-modal-backdrop" style="z-index:1060" @onclick="() => rejectingQuote = null">
        <div class="quote-modal quote-modal-sm" @onclick:stopPropagation="true">
            <h5>Απόρριψη προσφοράς @rejectingQuote.QuoteNumber</h5>
            <div class="mb-3">
                <label class="form-label">Λόγος (προαιρετικά)</label>
                <textarea class="form-control" rows="3" @bind="rejectReason"></textarea>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="() => rejectingQuote = null">Άκυρο</button>
                <button class="btn btn-danger" @onclick="ConfirmReject" disabled="@busy">Απόρριψη</button>
            </div>
        </div>
    </div>
}

@* ============ Modal δημιουργίας/επεξεργασίας ============ *@
@if (showEditModal)
{
    <div class="quote-modal-backdrop">
        <div class="quote-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">@(editQuoteId == null ? "Νέα Προσφορά" : $"Επεξεργασία {editQuoteNumber}")</h4>
                <button class="btn-close" @onclick="CloseEdit"></button>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1">Εταιρεία</label>
                    <select class="form-select" value="@editCompany" @onchange="OnCompanyChanged" disabled="@(editQuoteId != null)">
                        <option value="SM">SM</option>
                        <option value="BM">BM</option>
                    </select>
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label mb-1">Πελάτης (από λίστα γιατρών/νοσοκομείων)</label>
                    <div class="input-group">
                        <select class="form-select" @bind="editCustomerId">
                            <option value="">-- Επιλογή --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.DoctorID">@c.Name @(string.IsNullOrEmpty(c.Department) ? "" : $"({c.Department})")</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" title="Στοιχεία πελάτη (ΑΦΜ, email...)" @onclick="OpenEditCustomer" disabled="@(editCustomerId == null)">✎</button>
                        <button class="btn btn-outline-success" title="Νέος πελάτης" @onclick="OpenNewCustomer">+</button>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1">Ημ/νία έκδοσης</label>
                    <input type="date" class="form-control" @bind="editIssueDate" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1">Ισχύς έως</label>
                    <input type="date" class="form-control" @bind="editValidUntil" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label mb-1">Αρ. πρωτ. ζήτησης</label>
                    <input class="form-control" @bind="editHospitalRef" />
                </div>
            </div>

            <h6>Είδη</h6>
            <div class="table-responsive">
                <table class="table table-sm lines-table">
                    <thead>
                        <tr>
                            <th style="min-width:150px">Κωδικός Πρικ</th>
                            <th style="min-width:150px">Τύπος προϊόντος</th>
                            <th style="min-width:150px">Περιγραφή (προαιρετικά)</th>
                            <th style="width:70px">Ποσ.</th>
                            <th style="width:90px">Τιμή μον.</th>
                            <th style="width:70px">Έκπτ. %</th>
                            <th style="width:70px">ΦΠΑ %</th>
                            <th style="width:90px" class="text-end">Σύνολο</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in editLines)
                        {
                            <tr>
                                <td>
                                    <select class="form-select form-select-sm" @bind="line.CodePrick">
                                        <option value="">--</option>
                                        @foreach (var a in allergens)
                                        {
                                            <option value="@a.CodePrick">@a.CodePrick - @a.AllergenDescription</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" value="@line.ProductTypeCode"
                                            @onchange="e => OnProductTypeChanged(line, e.Value?.ToString())">
                                        <option value="">--</option>
                                        @foreach (var p in productTypes)
                                        {
                                            <option value="@p.ProductTypeCode">@p.ProductTypeCode - @p.Description</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="form-control form-control-sm" @bind="line.Description" /></td>
                                <td><input type="number" min="1" class="form-control form-control-sm text-end" @bind="line.Quantity" /></td>
                                <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="line.UnitPrice" /></td>
                                <td><input type="number" step="0.5" min="0" max="100" class="form-control form-control-sm text-end" @bind="line.DiscountPct" /></td>
                                <td><input type="number" step="0.5" min="0" class="form-control form-control-sm text-end" @bind="line.VatRate" /></td>
                                <td class="text-end align-middle">@LineTotal(line).ToString("N2") €</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => editLines.Remove(line)">×</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <button class="btn btn-sm btn-outline-primary" @onclick="AddLine">+ Γραμμή</button>
                <span class="ms-3 small text-muted">Εισαγωγή από Excel:</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadImportTemplate">Πρότυπο</button>
                <InputFile OnChange="OnImportFileSelected" accept=".xlsx" class="form-control form-control-sm" style="max-width:280px;" />
                @if (!string.IsNullOrEmpty(importSummary))
                {
                    <span class="small @(importHadErrors ? "text-danger" : "text-success")">@importSummary</span>
                }
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label mb-1">Όροι παράδοσης</label>
                    <input class="form-control" @bind="editTermsDelivery" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1">Όροι πληρωμής</label>
                    <input class="form-control" @bind="editTermsPayment" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1">Εγγύηση</label>
                    <input class="form-control" @bind="editTermsWarranty" />
                </div>
                <div class="col-12">
                    <label class="form-label mb-1">Εσωτερικές σημειώσεις</label>
                    <textarea class="form-control" rows="2" @bind="editNotes"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <div class="totals-box">
                    <div class="d-flex justify-content-between"><span>Καθαρή αξία:</span><span>@EditTotals().net.ToString("N2") €</span></div>
                    <div class="d-flex justify-content-between"><span>ΦΠΑ:</span><span>@EditTotals().vat.ToString("N2") €</span></div>
                    <div class="d-flex justify-content-between fw-bold"><span>Σύνολο:</span><span>@EditTotals().total.ToString("N2") €</span></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="CloseEdit">Άκυρο</button>
                    <button class="btn btn-success" @onclick="SaveQuote" disabled="@busy">Αποθήκευση</button>
                </div>
            </div>
        </div>
    </div>
}

@* ============ Modal νέου πελάτη ============ *@
@if (showCustomerModal)
{
    <div class="quote-modal-backdrop" style="z-index:1060" @onclick="() => showCustomerModal = false">
        <div class="quote-modal quote-modal-sm" @onclick:stopPropagation="true">
            <h5>@(newCustomer.DoctorID == 0 ? "Νέος πελάτης (νοσοκομείο)" : $"Στοιχεία πελάτη: {newCustomer.Name}")</h5>
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <label class="form-label mb-1">Επωνυμία *</label>
                    <input class="form-control" @bind="newCustomer.Name" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">ΑΦΜ</label>
                    <input class="form-control" @bind="newCustomer.VatNumber" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">Τμήμα</label>
                    <input class="form-control" @bind="newCustomer.Department" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">Υπεύθυνος</label>
                    <input class="form-control" @bind="newCustomer.ContactPerson" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">Email</label>
                    <input class="form-control" @bind="newCustomer.Email" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">Τηλέφωνο</label>
                    <input class="form-control" @bind="newCustomer.Phone" />
                </div>
                <div class="col-6">
                    <label class="form-label mb-1">Πόλη</label>
                    <input class="form-control" @bind="newCustomer.City" />
                </div>
                <div class="col-12">
                    <label class="form-label mb-1">Διεύθυνση</label>
                    <input class="form-control" @bind="newCustomer.Address" />
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="() => showCustomerModal = false">Άκυρο</button>
                <button class="btn btn-success" @onclick="SaveCustomer" disabled="@busy">Αποθήκευση</button>
            </div>
        </div>
    </div>
}

@code {
    private QuotesService Service => new QuotesService(dataService);

    private bool loading = true;
    private bool busy = false;
    private string? message;
    private bool messageIsError;

    private List<QuoteViewDto> quotes = new();
    private string filterCompany = "";
    private string filterStatus = "All";
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private string filterSearch = "";

    private QuoteViewDto? detailsQuote;
