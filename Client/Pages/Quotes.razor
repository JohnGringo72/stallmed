    // Προσυμπλήρωση τιμής από τον τύπο προϊόντος (χονδρική αν υπάρχει, αλλιώς λιανική).
    private void OnProductTypeChanged(SaveQuoteLineRequest line, string? code)
    {
        line.ProductTypeCode = code ?? "";
        var product = productTypes.FirstOrDefault(p => p.ProductTypeCode == code);
        if (product != null && line.UnitPrice == 0)
            line.UnitPrice = product.ExFactoryPrice ?? product.PublicPrice ?? 0;
    }

    // Live υπολογισμοί -- ίδια λογική με τον server (QuoteCalculator).
    private decimal LineTotal(SaveQuoteLineRequest l)
    {
        var line = new QuoteLine
        {
            Quantity = l.Quantity,
            UnitPrice = l.UnitPrice,
            DiscountPct = l.DiscountPct,
            VatRate = l.VatRate
        };
        QuoteCalculator.ComputeLine(line);
        return line.LineTotal;
    }

    private (decimal net, decimal vat, decimal total) EditTotals()
    {
        decimal net = 0, vat = 0;
        foreach (var l in editLines)
        {
            var line = new QuoteLine
            {
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                DiscountPct = l.DiscountPct,
                VatRate = l.VatRate
            };
            QuoteCalculator.ComputeLine(line);
            net += line.LineNet;
            vat += line.LineVat;
        }
        return (net, vat, net + vat);
    }

    private async Task SaveQuote()
    {
        if (editCustomerId == null)
        {
            ShowMessage("Επίλεξε πελάτη.", isError: true);
            return;
        }
        var validLines = editLines
            .Where(l => !string.IsNullOrEmpty(l.CodePrick) && !string.IsNullOrEmpty(l.ProductTypeCode) && l.Quantity > 0)
            .ToList();
        if (validLines.Count == 0)
        {
            ShowMessage("Συμπλήρωσε τουλάχιστον μία πλήρη γραμμή (κωδικός, τύπος, ποσότητα).", isError: true);
            return;
        }

        var req = new SaveQuoteRequest
        {
            Company = editCompany,
            CustomerDoctorID = editCustomerId,
            IssueDate = editIssueDate,
            ValidUntil = editValidUntil,
            HospitalRequestRef = editHospitalRef,
            Notes = editNotes,
            TermsDelivery = editTermsDelivery,
            TermsPayment = editTermsPayment,
            TermsWarranty = editTermsWarranty,
            CreatedBy = userManager.User?.IdUser,
            Lines = validLines
        };

        busy = true;
        var result = editQuoteId == null
            ? await Service.CreateQuote(req)
            : await Service.UpdateQuote(editQuoteId.Value, req);
        busy = false;

        if (result == null)
        {
            ShowMessage("Σφάλμα αποθήκευσης προσφοράς.", isError: true);
            return;
        }
        showEditModal = false;
        ShowMessage($"Η προσφορά {result.QuoteNumber} αποθηκεύτηκε.");
        await LoadQuotes();
        detailsQuote = quotes.FirstOrDefault(x => x.QuoteID == result.QuoteID);
    }

