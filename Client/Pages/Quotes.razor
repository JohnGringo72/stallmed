    private async Task SendQuote(QuoteViewDto q)
    {
        if (string.IsNullOrEmpty(q.CustomerEmail))
        {
            ShowMessage("Ο πελάτης δεν έχει email.", isError: true);
            return;
        }
        var ok = await JS.InvokeAsync<bool>("confirm", $"Αποστολή της προσφοράς {q.QuoteNumber} στο {q.CustomerEmail};");
        if (!ok) return;

        busy = true;
        var result = await Service.Send(q.QuoteID, new QuoteActionRequest { UserID = userManager.User?.IdUser });
        busy = false;
        if (result == null || !result.Success)
        {
            ShowMessage(result?.Message ?? "Σφάλμα αποστολής email. Έλεγξε τις ρυθμίσεις SMTP.", isError: true);
            return;
        }
        ShowMessage(result.Message ?? "Η προσφορά εστάλη.");
        await RefreshAndReopen(q.QuoteID);
    }

    private async Task Accept(QuoteViewDto q)
    {
        busy = true;
        var result = await Service.Accept(q.QuoteID, new QuoteActionRequest { UserID = userManager.User?.IdUser });
        busy = false;
        if (result == null || !result.Success)
        {
            ShowMessage("Δεν επιτρέπεται η ενέργεια.", isError: true);
            return;
        }
        await RefreshAndReopen(q.QuoteID);
    }

    private async Task ConfirmReject()
    {
        if (rejectingQuote == null) return;
        busy = true;
        var result = await Service.Reject(rejectingQuote.QuoteID,
            new QuoteActionRequest { UserID = userManager.User?.IdUser, Reason = rejectReason });
        busy = false;
        if (result == null || !result.Success)
        {
            ShowMessage("Δεν επιτρέπεται η ενέργεια.", isError: true);
            return;
        }
        var id = rejectingQuote.QuoteID;
        rejectingQuote = null;
        rejectReason = "";
        await RefreshAndReopen(id);
    }

