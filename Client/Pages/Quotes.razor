    private async Task LoadQuotes()
    {
        loading = true;
        StateHasChanged();
        quotes = await Service.GetQuotes(
            string.IsNullOrEmpty(filterCompany) ? null : filterCompany,
            filterStatus, null, filterFrom, filterTo,
            string.IsNullOrEmpty(filterSearch) ? null : filterSearch);
        loading = false;
        StateHasChanged();
    }

