@page "/mytasks/new"

<PageTitle>MyTask - Νέα Εργασία</PageTitle>

<div class="sbt-page-header">
    <img src="images/icons/icon-mytask.svg" alt="" class="sbt-page-icon" />
    <h3>Νέα Εργασία</h3>
</div>

<div class="card p-3 mt-3" style="max-width:700px;">
    <div class="mb-3">
        <label class="form-label">Τίτλος</label>
        <input class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Περιγραφή</label>
        <textarea class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Ανάθεση σε</label>
        <select class="form-select">
            <option>Επιλογή χρήστη</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Προθεσμία</label>
        <input type="date" class="form-control" />
    </div>

    <button class="btn btn-primary" title="@Hint("Δημιουργία νέας εργασίας")">Δημιουργία</button>
</div>

@code {
    [CascadingParameter] public UiPreferencesService? UiPrefs { get; set; }
    private string? Hint(string text) => (UiPrefs?.ShowHints ?? true) ? text : null;
}