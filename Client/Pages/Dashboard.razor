@page "/prick-dashboard"
@inject NavigationManager Navigation

@* Το Dashboard συγχωνεύτηκε με τη σελίδα Απόθεμα (/apothema) -- το route
   μένει μόνο για παλιά bookmarks/redirects (π.χ. route guard warehouse). *@

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/apothema", replace: true);
    }
}
