@page "/visits"
@using StallmedManager.Shared.Models
@inject DataService dataService
@inject UserManager userManager
@inject IJSRuntime JS

<PageTitle>Επισκέψεις</PageTitle>

<style>
    .last-visit-info { font-size: 0.88rem; }
</style>

<div class="sbt-page-header">
    <img src="images/icons/icon-mytask.svg" alt="" class="sbt-page-icon" />
    <h3 class="mb-3">Επισκέψεις Πωλητών</h3>
</div>

@if (!loading && !allowed)
{
    <div class="alert alert-warning">Η σελίδα είναι διαθέσιμη μόνο σε πωλητές και διαχειριστές.</div>
}

@if (allowed)
{

@if (!string.IsNullOrEmpty(banner))
{
    <div class="alert alert-success alert-dismissible">
        @banner
        <button type="button" class="btn-close" @onclick="() => banner = string.Empty"></button>
    </div>
}

@* ===== Νέα επίσκεψη ===== *@
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label mb-1">Ημερομηνία</label>
                <InputDate @bind-Value="newDate" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label mb-1">Γιατρός</label>
                <DoctorPicker Text="@newDoctorText" TextChanged="OnDoctorTextChanged" OnSelected="SelectDoctor" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label mb-1">Σημείωση (προαιρετικά)</label>
                <input class="form-control" @bind="newNotes" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="AddVisit"
                        disabled="@(busy || string.IsNullOrWhiteSpace(newDoctorText))">+ Καταχώρηση</button>
            </div>
        </div>
        @if (lastVisit != null)
        {
            <div class="mt-2 last-visit-info @(lastVisit.UserID == userManager.User?.IdUser ? "text-primary" : "text-danger")">
                ℹ️ Τελευταία επίσκεψη στον <strong>@lastVisit.DoctorName</strong>:
                <PersonBadge Name="@lastVisit.UserName" UserId="@lastVisit.UserID" /> στις <strong>@lastVisit.VisitDate.ToString("dd/MM/yyyy")</strong>
            </div>
        }
        else if (lastVisitChecked && selectedDoctor != null)
        {
            <div class="mt-2 last-visit-info text-success">✅ Καμία καταγεγραμμένη επίσκεψη σε αυτόν τον γιατρό.</div>
        }
    </div>
</div>

@* ===== Εναλλαγή: Λίστα επισκέψεων / Στατιστικά παραμέλησης ===== *@
<div class="btn-group mb-3 flex-wrap">
    <button class="btn @(!showStats && !showCalendar ? "btn-primary" : "btn-outline-primary")" @onclick="ShowList">📋 Επισκέψεις</button>
    <button class="btn @(showCalendar ? "btn-primary" : "btn-outline-primary")" @onclick="ShowCalendar">📅 Ημερολόγιο</button>
    <button class="btn @(showStats ? "btn-primary" : "btn-outline-primary")" @onclick="ShowStats">📊 Πού πρέπει να πάμε</button>
</div>

@if (showCalendar)
{
    <VisitsCalendar Users="users" Version="visitsVersion" Changed="Load" />
}
else if (showStats)
{
    @if (statsLoading)
    {
        <p><em>Φορτώνω...</em></p>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <div class="btn-group btn-group-sm">
                <button class="btn @(regionFilter == "" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => regionFilter = ""'>Όλες οι περιοχές</button>
                <button class="btn @(regionFilter == "ΑΘΗΝΑ" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => regionFilter = "ΑΘΗΝΑ"'>ΑΘΗΝΑ</button>
                <button class="btn @(regionFilter == "ΕΠΑΡΧΕΙΑ" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => regionFilter = "ΕΠΑΡΧΕΙΑ"'>ΕΠΑΡΧΕΙΑ</button>
            </div>
            <span class="text-muted small">
                @FilteredStats.Count() γιατροί — οι πιο παραμελημένοι πρώτοι. Κόκκινο: 90+ μέρες, πορτοκαλί: 45+.
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <SortTh Sorter="StatsSort" Key="days" By="s => s.DaysSince" Style="width:90px" Class="text-end">Μέρες</SortTh>
                        <SortTh Sorter="StatsSort" Key="doctor" By="s => s.DoctorName">Γιατρός</SortTh>
                        @* Η περιοχή διορθώνεται επιτόπου (select) -- χωρίς ταξινόμηση, αλλιώς η γραμμή θα πηδούσε. *@
                        <th style="width:130px">Περιοχή</th>
                        <SortTh Sorter="StatsSort" Key="last" By="s => s.LastVisitDate" Style="width:120px">Τελευταία</SortTh>
                        <SortTh Sorter="StatsSort" Key="by" By="s => PersonName.Short(s.LastVisitBy)" Style="width:180px">Από ποιον</SortTh>
                        <SortTh Sorter="StatsSort" Key="total" By="s => s.TotalVisits" Style="width:110px" Class="text-end d-none d-md-table-cell">Σύνολο επισκ.</SortTh>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in StatsSort.Apply(FilteredStats))
                    {
                        <tr>
                            <td class="text-end">
                                <span class="badge @(s.DaysSince > 90 ? "bg-danger" : s.DaysSince > 45 ? "bg-warning text-dark" : "bg-success")" style="font-size:0.9rem;">
                                    @s.DaysSince
                                </span>
                            </td>
                            <td>@s.DoctorName</td>
                            <td>
                                @if (s.DoctorID != null)
                                {
                                    @* Οι περιοχές στη βάση έχουν λάθη -- διορθώνονται επιτόπου εδώ. *@
                                    <select class="form-select form-select-sm" value="@(s.Region ?? "")"
                                            @onchange="e => SetRegion(s, e.Value?.ToString())">
                                        <option value="">—</option>
                                        <option value="ΑΘΗΝΑ">ΑΘΗΝΑ</option>
                                        <option value="ΕΠΑΡΧΕΙΑ">ΕΠΑΡΧΕΙΑ</option>
                                    </select>
                                }
                            </td>
                            <td>@s.LastVisitDate.ToString("dd/MM/yyyy")</td>
                            <td><PersonBadge Name="@s.LastVisitBy" /></td>
                            <td class="text-end d-none d-md-table-cell">@s.TotalVisits</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{

@* ===== Φίλτρα λίστας ===== *@
<div class="row g-2 mb-2 align-items-end">
    <div class="col-6 col-md-2">
        <label class="form-label mb-1">Από</label>
        <InputDate @bind-Value="filterFrom" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label mb-1">Έως</label>
        <InputDate @bind-Value="filterTo" class="form-control" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label mb-1">Πωλητής</label>
        <select class="form-select" @bind="filterUserId">
            <option value="">Όλοι</option>
            @foreach (var u in users)
            {
                <option value="@u.IdUser">@PersonName.Short(u.FullName)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label mb-1">Αναζήτηση γιατρού</label>
        <input class="form-control" @bind="filterSearch" @onkeyup="OnFilterKeyUp" placeholder="Enter για αναζήτηση" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="Load">🔍 Εμφάνιση</button>
    </div>
</div>

@if (loading)
{
    <p><em>Φορτώνω...</em></p>
}
else if (visits.Count == 0)
{
    <div class="alert alert-light border">Καμία επίσκεψη στο διάστημα αυτό.</div>
}
else
{
    <div class="mb-1 text-muted small">@visits.Count επισκέψεις</div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead>
                <tr>
                    <SortTh Sorter="VisitsSort" Key="date" By="v => v.VisitDate" Style="width:110px">Ημερομηνία</SortTh>
                    <SortTh Sorter="VisitsSort" Key="doctor" By="v => v.DoctorName">Γιατρός</SortTh>
                    <SortTh Sorter="VisitsSort" Key="user" By="v => PersonName.Short(v.UserName)" Style="width:180px">Πωλητής</SortTh>
                    <SortTh Sorter="VisitsSort" Key="notes" By="v => v.Notes">Σημείωση</SortTh>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in VisitsSort.Apply(visits))
                {
                    var mine = v.UserID == userManager.User?.IdUser;
                    <tr>
                        <td>@v.VisitDate.ToString("dd/MM/yyyy")</td>
                        <td>@v.DoctorName</td>
                        <td>
                            <PersonBadge Name="@v.UserName" UserId="@v.UserID" />
                        </td>
                        <td class="text-muted">@v.Notes</td>
                        <td class="text-end">
                            @if (mine || userManager.IsAdmin)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteVisit(v)"
                                        title="@Hint("Διαγραφή επίσκεψης")">×</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

}

}

@code {
    [CascadingParameter] public UiPreferencesService? UiPrefs { get; set; }
    private string? Hint(string text) => (UiPrefs?.ShowHints ?? true) ? text : null;

    private SalesService Service => new SalesService(dataService);

    private List<SalesVisitViewDto> visits = new();
    private List<IssueUserDto> users = new();
    private bool loading = true;
    private bool busy = false;
    private string banner = "";

    // Φίλτρα: προεπιλογή οι τελευταίες 60 ημέρες.
    private DateTime? filterFrom = DateTime.Today.AddDays(-60);
    private DateTime? filterTo = DateTime.Today;
    private string filterUserId = "";
    private string filterSearch = "";

    // Νέα επίσκεψη
    private DateTime? newDate = DateTime.Today;
    private string newDoctorText = "";
    private string newNotes = "";
    private SalesDoctorOptionDto? selectedDoctor;
    private SalesVisitViewDto? lastVisit;
    private bool lastVisitChecked = false;

    // Μόνο πωλητές + admin -- ο server το επιβάλλει ούτως ή άλλως (VendorOrAdmin).
    private bool allowed;

    // ---- Στατιστικά «πού πρέπει να πάμε» ----
    private bool showStats = false;
    private bool showCalendar = false;

    private void ShowList()
    {
        showStats = false;
        showCalendar = false;
    }

    private void ShowCalendar()
    {
        showStats = false;
        showCalendar = true;
    }
    private bool statsLoading = false;
    private List<SalesVisitStatsRow> stats = new();
    private string regionFilter = "";

    private IEnumerable<SalesVisitStatsRow> FilteredStats =>
        string.IsNullOrEmpty(regionFilter) ? stats : stats.Where(s => s.Region == regionFilter);

    // Κοινή ταξινόμηση πινάκων (TableSort + SortTh) -- θυμάται την επιλογή.
    private TableSort<SalesVisitStatsRow>? statsSort;
    private TableSort<SalesVisitStatsRow> StatsSort => statsSort ??= new(this, "visits-stats");
    private TableSort<SalesVisitViewDto>? visitsSort;
    private TableSort<SalesVisitViewDto> VisitsSort => visitsSort ??= new(this, "visits-list");

    private async Task ShowStats()
    {
        showStats = true;
        showCalendar = false;
        statsLoading = true;
        stats = await Service.GetVisitStats();
        statsLoading = false;
    }

    private async Task SetRegion(SalesVisitStatsRow s, string? region)
    {
        if (s.DoctorID == null) return;
        s.Region = string.IsNullOrEmpty(region) ? null : region;
        await Service.SetDoctorRegion(new SetDoctorRegionRequest { DoctorID = s.DoctorID.Value, Region = s.Region });
    }

    protected override async Task OnInitializedAsync()
    {
        allowed = userManager.IsVendor || userManager.IsAdmin;
        if (!allowed) { loading = false; return; }
        users = await Service.GetUsers();
        await Load();
    }

    // Αυξάνεται σε κάθε φόρτωση (νέα/διαγραφή επίσκεψης, φίλτρα): ξαναφορτώνει και το ημερολόγιο.
    private int visitsVersion;

    private async Task Load()
    {
        visitsVersion++;
        loading = true;
        int? uid = int.TryParse(filterUserId, out var id) ? id : null;
        visits = await Service.GetVisits(
            filterFrom ?? DateTime.Today.AddDays(-60),
            filterTo ?? DateTime.Today,
            uid,
            string.IsNullOrWhiteSpace(filterSearch) ? null : filterSearch.Trim());
        loading = false;
    }

    private async Task OnFilterKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    // Η αναζήτηση γίνεται από το κοινό <DoctorPicker>· εδώ μόνο: πληκτρολόγηση = όχι επιλεγμένος γιατρός.
    private void OnDoctorTextChanged(string text)
    {
        newDoctorText = text;
        selectedDoctor = null;
        lastVisit = null;
        lastVisitChecked = false;
    }

    private async Task SelectDoctor(SalesDoctorOptionDto d)
    {
        selectedDoctor = d;
        newDoctorText = d.DisplayName;
        lastVisit = await Service.GetLastVisit(d.DoctorID, null);
        lastVisitChecked = true;
    }

    private async Task AddVisit()
    {
        if (string.IsNullOrWhiteSpace(newDoctorText) || userManager.User == null) return;
        busy = true;
        var result = await Service.SaveVisit(new SaveSalesVisitRequest
        {
            UserID = userManager.User.IdUser,
            DoctorID = selectedDoctor?.DoctorID,
            DoctorName = newDoctorText.Trim(),
            VisitDate = newDate ?? DateTime.Today,
            Notes = newNotes
        });
        busy = false;
        if (result == null || !result.Success)
        {
            banner = result?.Message ?? "Η καταχώρηση απέτυχε.";
            return;
        }
        banner = $"✅ Καταχωρήθηκε επίσκεψη στον {newDoctorText.Trim()}.";
        newDoctorText = "";
        newNotes = "";
        selectedDoctor = null;
        lastVisit = null;
        lastVisitChecked = false;
        await Load();
    }

    private async Task DeleteVisit(SalesVisitViewDto v)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Διαγραφή επίσκεψης στον «{v.DoctorName}» ({v.VisitDate:dd/MM/yyyy});");
        if (!ok) return;
        var result = await Service.DeleteVisit(new DeleteSalesVisitRequest
        {
            VisitID = v.VisitID,
            UserID = userManager.User?.IdUser ?? 0
        });
        if (result != null && !result.Success && !string.IsNullOrEmpty(result.Message))
        {
            banner = result.Message;
            return;
        }
        await Load();
    }
}
