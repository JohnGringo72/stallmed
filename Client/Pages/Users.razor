@page "/users"
@using StallmedManager.Shared.Models
@inject DataService dataService
@inject UserManager userManager
@inject NavigationManager nav

<PageTitle>Διαχείριση Χρηστών</PageTitle>

<style>
    .users-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .role-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        color: white;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .user-inactive td { color: #9aa0a6; }
</style>

<div class="sbt-page-header">
    <h1 class="mb-3">👤 Χρήστες & Ρόλοι</h1>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") py-2 alert-dismissible">
        @message
        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
    </div>
}

<div class="users-panel d-flex gap-2 align-items-center flex-wrap">
    <button class="btn btn-success" @onclick="OpenNew">➕ Νέος Χρήστης</button>
    <button class="btn btn-outline-warning ms-2" @onclick="() => confirmResetAll = true"
            title="Βάζει σε ΟΛΟΥΣ τον προεπιλεγμένο κωδικό και υποχρεωτική αλλαγή στην πρώτη είσοδο">
        ↺ Επαναφορά κωδικών σε όλους
    </button>
    <button class="btn btn-outline-secondary" @onclick="LoadData">↻ Ανανέωση</button>
    <div class="form-check form-switch ms-auto mb-0">
        <input class="form-check-input" type="checkbox" id="showInactive" @bind="showInactive" />
        <label class="form-check-label" for="showInactive">Εμφάνιση ανενεργών</label>
    </div>
</div>

<div class="users-panel">
    <h5 class="mb-2">📧 Ρυθμίσεις email</h5>
    @if (!emailStatus.Any())
    {
        <div class="text-muted small">Φορτώνω...</div>
    }
    else
    {
        <div class="table-responsive mb-2">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Εταιρεία</th><th>Διακομιστής</th><th>Θύρα</th><th>Αποστολέας</th><th>Κωδικός</th><th>Κατάσταση</th></tr>
                </thead>
                <tbody>
                    @foreach (var st in emailStatus)
                    {
                        <tr>
                            <td><strong>@st.Company</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(st.Host) ? "—" : st.Host)</td>
                            <td>@st.Port</td>
                            <td>@(string.IsNullOrWhiteSpace(st.FromAddress) ? "—" : st.FromAddress)</td>
                            <td>@(st.HasPassword ? "✔" : "—")</td>
                            <td>
                                @if (st.Configured)
                                {
                                    <span class="badge bg-success">Έτοιμο</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Λείπουν στοιχεία</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <select class="form-control" style="width:auto;" @bind="testCompany">
                @foreach (var st in emailStatus)
                {
                    <option value="@st.Company">@st.Company</option>
                }
            </select>
            <input class="form-control" style="max-width:280px;" placeholder="Παραλήπτης δοκιμής" @bind="testAddress" />
            <button class="btn btn-outline-primary" @onclick="SendTestEmail" disabled="@testBusy">
                @(testBusy ? "Στέλνω..." : "✉️ Δοκιμαστικό email")
            </button>
            @if (!string.IsNullOrEmpty(testResult))
            {
                <span class="@(testOk ? "text-success" : "text-danger") small">@testResult</span>
            }
        </div>
        <div class="form-text">
            Τα στοιχεία συμπληρώνονται στο <code>Server/appsettings.json</code>, στην ενότητα <code>Smtp</code>.
            Ο κωδικός δεν εμφανίζεται ποτέ εδώ.
        </div>
    }
</div>

@if (status == "loading")
{
    <p><em>Φορτώνω...</em></p>
}
else if (status == "loaded")
{
    <div class="table-responsive list-window">
        <table class="table table-hover table-sm sticky-head">
            <thead>
                <tr>
                    <th>Ονοματεπώνυμο</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Ρόλος</th>
                    <th>Ομάδα</th>
                    <th>Θέματα</th>
                    <th>Κατάσταση</th>
                    <th>Κωδικός</th>
                    <th>Τελευταία σύνδεση</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in VisibleUsers)
                {
                    <tr class="@(u.Active ? "" : "user-inactive")">
                        <td><strong>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</strong></td>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td><span class="role-badge" style="background-color:@RoleColor(u.Role)">@u.Role</span></td>
                        <td>
                            @if (string.IsNullOrEmpty(u.Team))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Teams.Label(u.Team)</span>
                            }
                        </td>
                        <td>
                            @if (u.TasksVisibility == "All")
                            {
                                <span class="badge bg-primary" title="Βλέπει όλα τα θέματα">Όλα</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark" title="Βλέπει μόνο όσα άνοιξε ή του ανατέθηκαν">Μόνο τα δικά του</span>
                            }
                        </td>
                        <td>
                            @if (u.Active)
                            {
                                <span class="badge bg-success">Ενεργός</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ανενεργός</span>
                            }
                        </td>
                        <td>
                            @if (u.HasEncryptedPassword)
                            {
                                <span title="Αποθηκευμένος ως hash -- δεν διαβάζεται από κανέναν">🔒</span>
                            }
                            else
                            {
                                <span class="text-warning" title="Παλιά μορφή -- γίνεται hash αυτόματα στην επόμενη είσοδό του">⏳ παλιά μορφή</span>
                            }
                            @if (u.ForcePasswordChange)
                            {
                                <span class="badge bg-warning text-dark ms-1" title="Θα υποχρεωθεί να αλλάξει κωδικό στην επόμενη είσοδο">αλλαγή</span>
                            }
                        </td>
                        <td>@(u.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(u)" title="Επεξεργασία στοιχείων και ρόλου">✏️</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenPassword(u)" title="Ορισμός νέου κωδικού">🔑</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ResetOne(u)"
                                    title="Επαναφορά στον προεπιλεγμένο κωδικό -- θα τον αλλάξει στην πρώτη είσοδο">↺</button>
                            @if (u.Active)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleActive(u, false)" title="Απενεργοποίηση -- δεν θα μπορεί να συνδεθεί">⛔</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleActive(u, true)" title="Ενεργοποίηση">✅</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!VisibleUsers.Any())
    {
        <div class="alert alert-info">Δεν υπάρχουν χρήστες με αυτά τα κριτήρια.</div>
    }
}

@* ===== Modal: Νέος / Επεξεργασία ===== *@
@if (editUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">@(editUser.IdUser == null ? "Νέος Χρήστης" : $"Επεξεργασία: {editUser.Username}")</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label mb-1">Όνομα</label>
                            <input class="form-control" @bind="editUser.Firstname" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1">Επώνυμο</label>
                            <input class="form-control" @bind="editUser.Lastname" />
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-1">Username <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="editUser.Username" />
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-1">Email</label>
                            <input class="form-control" type="email" @bind="editUser.Email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1">ΑΜΚΑ</label>
                            <input class="form-control" @bind="editUser.AMKA" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-1">Ρόλος <span class="text-danger">*</span></label>
                            <select class="form-control" @bind="roleChoice">
                                @foreach (var r in roles)
                                {
                                    <option value="@r">@r</option>
                                }
                                <option value="@NewRoleOption">-- νέος ρόλος --</option>
                            </select>
                        </div>
                        @if (roleChoice == NewRoleOption)
                        {
                            <div class="col-12">
                                <label class="form-label mb-1">Όνομα νέου ρόλου</label>
                                <input class="form-control" @bind="newRoleName" placeholder="π.χ. sales" />
                                <div class="form-text">Προσοχή: νέος ρόλος δεν ξεκλειδώνει από μόνος του δικαιώματα. Τα δικαιώματα ορίζονται στον κώδικα (σήμερα: admin, warehouse).</div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label mb-1">Ομάδα</label>
                            <select class="form-control" @bind="editUser.Team">
                                <option value="">— καμία —</option>
                                @foreach (var team in Teams.All)
                                {
                                    <option value="@team.Code">@team.Label</option>
                                }
                            </select>
                            <div class="form-text">Καθορίζει ποια θέματα ομάδας βλέπει, και πού εμφανίζεται στη λίστα ανάθεσης.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-1">Ορατότητα θεμάτων (Tasks)</label>
                            <select class="form-control" @bind="editUser.TasksVisibility">
                                <option value="Own">Μόνο όσα άνοιξε ή του ανατέθηκαν</option>
                                <option value="All">Όλα τα θέματα</option>
                            </select>
                            <div class="form-text">Ανεξάρτητο από τον ρόλο -- ορίζεται ξεχωριστά για κάθε χρήστη.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-1">Αρχική σελίδα</label>
                            <select class="form-control" @bind="editUser.StartPage">
                                @foreach (var sp in StartPages.Known)
                                {
                                    <option value="@(sp.Path == "/" ? "" : sp.Path)">@sp.Label</option>
                                }
                                @* Σελίδα που διάλεξε ο ίδιος με το 🏠 και δεν είναι στη λίστα *@
                                @if (!string.IsNullOrEmpty(editUser.StartPage)
                                     && !StartPages.Known.Any(k => string.Equals(k.Path, editUser.StartPage, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@editUser.StartPage">@editUser.StartPage</option>
                                }
                            </select>
                            <div class="form-text">Ανοίγει όταν μπαίνει. Ο χρήστης μπορεί να την αλλάξει και μόνος του με το 🏠 σε όποια σελίδα βρίσκεται.</div>
                        </div>
                        @if (editUser.IdUser == null)
                        {
                            <div class="col-6">
                                <label class="form-label mb-1">Αρχικός κωδικός <span class="text-danger">*</span></label>
                                <input class="form-control" type="password" @bind="newPassword" autocomplete="new-password" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-1">Επανάληψη</label>
                                <input class="form-control" type="password" @bind="newPasswordRepeat" autocomplete="new-password" />
                            </div>
                        }
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="activeSwitch" @bind="editUser.Active" />
                                <label class="form-check-label" for="activeSwitch">Ενεργός</label>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(modalMessage))
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0">@modalMessage</div>
                    }
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseEdit">Ακύρωση</button>
                    <button class="btn btn-success btn-sm" @onclick="SaveUser" disabled="@busy">Αποθήκευση</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Επιβεβαίωση: επαναφορά ενός χρήστη ===== *@
@if (resetUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">↺ Επαναφορά κωδικού</h5>
                    <button type="button" class="btn-close" @onclick="() => resetUser = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Ο κωδικός του <strong>@resetUser.Username</strong> θα γίνει ο προεπιλεγμένος
                        και θα υποχρεωθεί να τον αλλάξει στην επόμενη είσοδο.
                    </p>
                    <p class="text-muted small mb-0">Ο τωρινός του κωδικός παύει να ισχύει.</p>
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm" @onclick="() => resetUser = null">Ακύρωση</button>
                    <button class="btn btn-warning btn-sm" @onclick="() => DoReset(resetUser!.IdUser)">Επαναφορά</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Επιβεβαίωση: επαναφορά ΟΛΩΝ ===== *@
@if (confirmResetAll)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title text-danger">↺ Επαναφορά κωδικών σε ΟΛΟΥΣ</h5>
                    <button type="button" class="btn-close" @onclick="() => confirmResetAll = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-2">
                        Όλοι οι χρήστες, <strong>μαζί κι εσύ</strong>, θα πάρουν τον προεπιλεγμένο κωδικό.
                        Όποιος έχει δικό του κωδικό <strong>τον χάνει</strong>.
                    </div>
                    <p class="mb-1">Στην επόμενη είσοδο ο καθένας θα υποχρεωθεί να ορίσει δικό του κωδικό.</p>
                    <p class="text-muted small mb-0">Η ενέργεια δεν αναιρείται.</p>
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm" @onclick="() => confirmResetAll = false">Ακύρωση</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => DoReset(null)">Ναι, επαναφορά σε όλους</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal: Κωδικός ===== *@
@if (passwordUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">🔑 Κωδικός: @passwordUser.Username</h5>
                    <button type="button" class="btn-close" @onclick="ClosePassword"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label mb-1">Νέος κωδικός</label>
                    <input class="form-control mb-2" type="password" @bind="newPassword" autocomplete="new-password" />
                    <label class="form-label mb-1">Επανάληψη</label>
                    <input class="form-control" type="password" @bind="newPasswordRepeat" autocomplete="new-password" />
                    @if (!string.IsNullOrEmpty(modalMessage))
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0">@modalMessage</div>
                    }
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm" @onclick="ClosePassword">Ακύρωση</button>
                    <button class="btn btn-success btn-sm" @onclick="SavePassword" disabled="@busy">Αποθήκευση</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string NewRoleOption = "__new__";

    private UsersService Service => new UsersService(dataService);

    private string status = "idle";
    private string message = "";
    private bool messageIsError;
    private bool busy;
    private bool showInactive = true;

    private List<UserAdminDto> users = new();
    private List<EmailStatusDto> emailStatus = new();
    private string testCompany = "SM";
    private string testAddress = "";
    private string testResult = "";
    private bool testOk;
    private bool testBusy;

    private async Task SendTestEmail()
    {
        testResult = "";
        testBusy = true;
        var result = await Service.SendTestEmail(new TestEmailRequest { Company = testCompany, ToAddress = testAddress });
        testBusy = false;

        testOk = result?.Success == true;
        testResult = result?.Message ?? "Κάτι πήγε στραβά. Δοκίμασε ξανά.";
    }
    private List<string> roles = new();

    private SaveUserRequest? editUser;
    private UserAdminDto? passwordUser;
    private string roleChoice = "";
    private string newRoleName = "";
    private string newPassword = "";
    private string newPasswordRepeat = "";
    private string modalMessage = "";

    private IEnumerable<UserAdminDto> VisibleUsers => showInactive ? users : users.Where(u => u.Active);

    protected override async Task OnInitializedAsync()
    {
        // Ο ίδιος έλεγχος υπάρχει και στον server (policy AdminOnly) -- εδώ μόνο
        // για να μη φορτώνει καν η σελίδα σε μη-admin.
        if (!userManager.IsAdmin)
        {
            nav.NavigateTo("/");
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        status = "loading";
        StateHasChanged();
        users = await Service.GetUsers();
        roles = await Service.GetRoles();
        emailStatus = await Service.GetEmailStatus();
        if (string.IsNullOrWhiteSpace(testAddress))
            testAddress = userManager.User?.Email ?? "";
        status = "loaded";
    }

    private static string RoleColor(string? role) => (role ?? "").Trim().ToLowerInvariant() switch
    {
        "admin" => "#dc3545",
        "warehouse" => "#fd7e14",
        "vendor" => "#0d6efd",
        _ => "#6c757d"
    };

    private void OpenNew()
    {
        editUser = new SaveUserRequest { Active = true, TasksVisibility = "Own" };
        roleChoice = roles.FirstOrDefault() ?? NewRoleOption;
        newRoleName = "";
        newPassword = newPasswordRepeat = "";
        modalMessage = "";
    }

    private void OpenEdit(UserAdminDto u)
    {
        editUser = new SaveUserRequest
        {
            IdUser = u.IdUser,
            Username = u.Username,
            Email = u.Email,
            Firstname = u.Firstname,
            Lastname = u.Lastname,
            AMKA = u.AMKA,
            Role = u.Role,
            Active = u.Active,
            TasksVisibility = u.TasksVisibility,
            Team = u.Team,
            StartPage = u.StartPage ?? ""
        };
        roleChoice = roles.Contains(u.Role) ? u.Role : NewRoleOption;
        newRoleName = roles.Contains(u.Role) ? "" : u.Role;
        modalMessage = "";
    }

    private void CloseEdit()
    {
        editUser = null;
        newPassword = newPasswordRepeat = "";
        modalMessage = "";
    }

    private async Task SaveUser()
    {
        if (editUser == null) return;
        modalMessage = "";

        editUser.Role = roleChoice == NewRoleOption ? (newRoleName ?? "").Trim() : roleChoice;
        if (string.IsNullOrWhiteSpace(editUser.Role))
        {
            modalMessage = "Δώσε ρόλο.";
            return;
        }

        if (editUser.IdUser == null)
        {
            if (newPassword != newPasswordRepeat)
            {
                modalMessage = "Οι δύο κωδικοί δεν ταιριάζουν.";
                return;
            }
            editUser.Password = newPassword;
        }

        busy = true;
        var result = await Service.Save(editUser);
        busy = false;

        if (result == null)
        {
            modalMessage = "Κάτι πήγε στραβά. Δοκίμασε ξανά.";
            return;
        }
        if (!result.Success)
        {
            modalMessage = result.Message ?? "Η αποθήκευση απέτυχε.";
            return;
        }

        ShowMessage(result.Message ?? "Αποθηκεύτηκε.", false);
        CloseEdit();
        await LoadData();
    }

    private void OpenPassword(UserAdminDto u)
    {
        passwordUser = u;
        newPassword = newPasswordRepeat = "";
        modalMessage = "";
    }

    private void ClosePassword()
    {
        passwordUser = null;
        newPassword = newPasswordRepeat = "";
        modalMessage = "";
    }

    private async Task SavePassword()
    {
        if (passwordUser == null) return;
        if (newPassword != newPasswordRepeat)
        {
            modalMessage = "Οι δύο κωδικοί δεν ταιριάζουν.";
            return;
        }

        busy = true;
        var result = await Service.SetPassword(new SetUserPasswordRequest
        {
            IdUser = passwordUser.IdUser,
            Password = newPassword
        });
        busy = false;

        if (result == null || !result.Success)
        {
            modalMessage = result?.Message ?? "Κάτι πήγε στραβά. Δοκίμασε ξανά.";
            return;
        }

        ShowMessage(result.Message ?? "Ο κωδικός ενημερώθηκε.", false);
        ClosePassword();
        await LoadData();
    }

    // ---- Επαναφορά στον προεπιλεγμένο κωδικό ----

    private UserAdminDto? resetUser;      // επιβεβαίωση για έναν χρήστη
    private bool confirmResetAll;         // επιβεβαίωση για όλους

    private async Task DoReset(int? idUser)
    {
        var result = await Service.ResetPassword(new ResetPasswordRequest { IdUser = idUser });
        resetUser = null;
        confirmResetAll = false;

        if (result == null || !result.Success)
        {
            ShowMessage(result?.Message ?? "Κάτι πήγε στραβά.", true);
            return;
        }
        ShowMessage(result.Message ?? "Έγινε.", false);
        await LoadData();
    }

    private void ResetOne(UserAdminDto u) => resetUser = u;

    private async Task ToggleActive(UserAdminDto u, bool active)
    {
        var result = await Service.SetActive(new SetUserActiveRequest { IdUser = u.IdUser, Active = active });
        if (result == null || !result.Success)
        {
            ShowMessage(result?.Message ?? "Κάτι πήγε στραβά.", true);
            return;
        }
        ShowMessage(result.Message ?? "Έγινε.", false);
        await LoadData();
    }

    private void ShowMessage(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }
}
